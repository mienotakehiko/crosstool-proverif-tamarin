# Use exact upstream source revisions for the reproduction build.
ARG GHC_VERSION=9.6.7
ARG MAUDE_VERSION=Maude3.5
ARG TAMARIN_REPOSITORY=https://github.com/tamarin-prover/tamarin-prover.git
ARG TAMARIN_REF=c293106913ccf7bb41f49b0dc555a8074e8ea88c
ARG PROVERIF_REF=1d4cd9458d9ccf648e149ec2ea5147b2c87b67df

#----------------------------------------------------
# Stage 0: Fetch Tamarin
#----------------------------------------------------
FROM debian:bookworm-slim AS tamarin-source
ARG TAMARIN_REPOSITORY
ARG TAMARIN_REF

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/tamarin
RUN git init . \
    && git remote add origin "${TAMARIN_REPOSITORY}" \
    && git fetch --depth 1 origin "${TAMARIN_REF}" \
    && git checkout --detach FETCH_HEAD \
    && git rev-parse HEAD > TAMARIN_COMMIT \
    && test "$(cat TAMARIN_COMMIT)" = "${TAMARIN_REF}"

#----------------------------------------------------
# Stage 1: Build Maude from source
#----------------------------------------------------
FROM debian:bookworm-slim AS maude-build
ARG MAUDE_VERSION

# install Maude’s build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    bison \
    flex \
    autoconf \
    automake \
    libtool \
    libtool-bin \
    dh-autoreconf \
    libsigsegv-dev \
    libgmp-dev \
    libtecla-dev \
    libbdd-dev \
    pkg-config \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# bring the static GMP .a’s into /usr/lib so configure’s GMP_LIBS can see them
RUN mkdir -p /usr/lib && \
    ln -s /usr/lib/*-linux-gnu/libgmp.a      /usr/lib/libgmp.a    && \
    ln -s /usr/lib/*-linux-gnu/libgmpxx.a    /usr/lib/libgmpxx.a

WORKDIR /opt/maude-src
RUN git clone --depth 1 --branch ${MAUDE_VERSION} https://github.com/maude-lang/Maude.git . \
    && autoreconf -i

RUN mkdir build && cd build && \
    ../configure \
    --with-yices2=no \
    --with-cvc4=no \
    --enable-compiler \
    CXXFLAGS="-g -Wall -O3 -fno-stack-protector" \
    CPPFLAGS="-I/usr/include" \
    LDFLAGS="-L/usr/lib" \
    GMP_LIBS="/usr/lib/libgmpxx.a /usr/lib/libgmp.a" && \
    make -j$(nproc) && \
    make check && \
    make install

#----------------------------------------------------
# Stage 2: Build Haskell Dependencies for Tamarin
#----------------------------------------------------
FROM haskell:${GHC_VERSION} AS tamarin-dependencies

WORKDIR /opt/build

RUN apt-get update && apt-get install -y --no-install-recommends \
    libncurses-dev \
    zlib1g-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Copy only the files and folders that Stack needs to determine and build the
# dependencies. The translation source is obtained from Tamarin rather than
# duplicated in this artifact.
COPY --from=tamarin-source /opt/tamarin/stack.yaml /opt/tamarin/tamarin-prover.cabal ./
COPY --from=tamarin-source /opt/tamarin/LICENSE ./
COPY --from=tamarin-source /opt/tamarin/lib/. ./lib/
COPY --from=tamarin-source /opt/tamarin/src ./src
COPY --from=tamarin-source /opt/tamarin/data ./data
COPY --from=tamarin-source /opt/tamarin/images ./images

RUN stack build --system-ghc --dependencies-only

#----------------------------------------------------
# Stage 3: Build Tamarin
#----------------------------------------------------
FROM haskell:${GHC_VERSION} AS tamarin-build

COPY --from=tamarin-dependencies /root/.stack /root/.stack
COPY --from=tamarin-dependencies /opt/build /opt/build

WORKDIR /opt/build

RUN stack install --system-ghc --local-bin-path /opt/build/bin

# Install binutils, strip the tamarin binary, and clean up in one layer
RUN apt-get update && \
    apt-get install -y --no-install-recommends binutils && \
    strip /opt/build/bin/tamarin-prover && \
    apt-get purge -y --auto-remove binutils && \
    rm -rf /var/lib/apt/lists/*

#----------------------------------------------------
# Stage 4: Build ProVerif
#----------------------------------------------------
FROM ocaml/opam:debian-12-ocaml-5.3 AS proverif-build
ARG PROVERIF_REF
USER root
WORKDIR /opt/build

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    pkg-config \
    libexpat1-dev \
    libgtk2.0-dev \
    && rm -rf /var/lib/apt/lists/*

# Use the exact upstream ProVerif revision selected by Tamarin's evaluation
# image. This revision includes the liveness-restriction fix.
RUN git clone https://gitlab.inria.fr/bblanche/proverif.git . && \
    git checkout "${PROVERIF_REF}" && \
    git rev-parse HEAD > PROVERIF_COMMIT && \
    test "$(cat PROVERIF_COMMIT)" = "${PROVERIF_REF}"

RUN opam install -y ocamlfind ocamlbuild lablgtk
RUN eval $(opam config env) && cd proverif && ./build

#----------------------------------------------------
# Stage 5: Runtime Evaluation Image
#----------------------------------------------------
FROM debian:bookworm-slim AS eval

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    MAUDE_LIB=/usr/local/share

# Install runtime dependencies for Tamarin and all dependencies for the evaluation setup
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    # Tamarin runtime deps
    graphviz libbdd0c2 libtecla1 libsigsegv2 \
    # Eval setup deps
    python3 python3-pip python3-dev \
    build-essential \
    curl \
    time && \
    # Install Node.js 18.x and tree-sitter CLI for eval setup
    curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    npm install -g tree-sitter-cli && \
    # Clean up
    rm -rf /var/lib/apt/lists/*

# Copy built artifacts from previous stages
COPY --from=maude-build /usr/local/share/prelude.maude /usr/local/share/
COPY --from=maude-build /usr/local/bin/maude /usr/local/bin/
COPY --from=tamarin-build /opt/build/bin /usr/local/bin/
COPY --from=proverif-build /opt/build/proverif/proverif /usr/local/bin/

WORKDIR /opt/eval

# Copy the evaluation corpus from the selected upstream Tamarin checkout and
# the exact evaluation helpers shipped with this artifact.
COPY --from=tamarin-source /opt/tamarin/examples ./examples
COPY --from=tamarin-source /opt/tamarin/TAMARIN_COMMIT ./TAMARIN_COMMIT
COPY --from=proverif-build /opt/build/PROVERIF_COMMIT ./PROVERIF_COMMIT
COPY eval.py .
COPY filter.py .
COPY duplicates.py .

# Copy and install tree-sitter-spthy grammar
COPY --from=tamarin-source /opt/tamarin/tree-sitter/tree-sitter-spthy/ ./tree-sitter-spthy/
RUN pip3 install --break-system-packages \
    pip==24.3.1 \
    numpy==2.2.5 \
    scipy==1.15.2 \
    tree-sitter==0.24.0 \
    datasketch==1.6.5 \
    && pip3 install --break-system-packages ./tree-sitter-spthy

CMD ["bash"]

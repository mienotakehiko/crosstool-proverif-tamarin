{
  "model": "t6_continuation",
  "theory": "CimT6Continuation",
  "constants": ["empty_new", "empty_pair"],
  "functions": {"tempctx": 2, "newctx": 3},
  "init": {
    "fresh": ["exchange_id", "old_ctx", "prior_local_pair", "prior_peer_pair", "incoming_pair", "incoming_id"],
    "emit": [["PendingBefore", "exchange_id", "old_ctx", ["newctx", "old_ctx", "prior_local_pair", "prior_peer_pair"], "prior_local_pair"]],
    "produce": [
      ["Pending", "exchange_id", "old_ctx", ["newctx", "old_ctx", "prior_local_pair", "prior_peer_pair"], "prior_local_pair"],
      ["BeforeSnapshot", "exchange_id", "old_ctx", ["newctx", "old_ctx", "prior_local_pair", "prior_peer_pair"], "prior_local_pair"],
      ["VerifiedOldPremise", "exchange_id", "incoming_id", "old_ctx", "incoming_pair"]
    ]
  },
  "steps": [
    {
      "id": "RecordVerifiedReceipt",
      "consume": [["VerifiedOldPremise", "exchange_id", "incoming_id", "old_ctx", "peer_pair"]],
      "emit": [["OldVerified", "exchange_id", "incoming_id", "old_ctx", "peer_pair", ["tempctx", "old_ctx", "peer_pair"]]],
      "produce": [["VerifiedDivergent", "exchange_id", "incoming_id", "old_ctx", "peer_pair", ["tempctx", "old_ctx", "peer_pair"]]]
    },
    {
      "id": "AbortOnOldDerived",
      "consume": [
        ["Pending", "exchange_id", "old_ctx", "discarded_ctx", "discarded_pair"],
        ["VerifiedDivergent", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp"]
      ],
      "require_equal": ["rx_temp", ["tempctx", "old_ctx", "peer_pair"]],
      "emit": [["PendingAborted", "exchange_id", "incoming_id", "old_ctx", "discarded_ctx", "discarded_pair"]],
      "produce": [["BusyEntry", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp", "empty_new", "empty_pair"]]
    },
    {
      "id": "ReadBusyEntry",
      "consume": [["BusyEntry", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp", "ctx_slot", "pair_slot"]],
      "emit": [["BusyEntryRead", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp", "ctx_slot", "pair_slot"]],
      "produce": [["BusyReady", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp", "ctx_slot", "pair_slot"]]
    },
    {
      "id": "DeriveNewContext",
      "consume": [["BusyReady", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp", "empty_new", "empty_pair"]],
      "fresh": ["fresh_local_pair"],
      "emit": [["RestartDerived", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "fresh_local_pair", ["newctx", "old_ctx", "fresh_local_pair", "peer_pair"]]],
      "produce": [["ReadyToSend", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp", "fresh_local_pair", ["newctx", "old_ctx", "fresh_local_pair", "peer_pair"]]]
    },
    {
      "id": "SendConvergent",
      "consume": [["ReadyToSend", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp", "local_pair", "active_ctx"]],
      "emit": [["ConvergentSent", "exchange_id", "incoming_id", "active_ctx"]],
      "produce": [["PendingAfter", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp", "local_pair", "active_ctx"]]
    },
    {
      "id": "ReadPending",
      "consume": [
        ["PendingAfter", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp", "local_pair", "active_ctx"],
        ["BeforeSnapshot", "exchange_id", "old_ctx", "discarded_ctx", "discarded_pair"]
      ],
      "emit": [["PendingRead", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "local_pair", "active_ctx", "discarded_ctx", "discarded_pair", "rx_temp"]],
      "produce": []
    }
  ],
  "observed": ["PendingRead", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "local_pair", "active_ctx", "discarded_ctx", "discarded_pair", "rx_temp"],
  "properties": [
    {"id": "reachable", "kind": "exists"},
    {
      "id": "old_receipt_and_clear",
      "kind": "correspondence",
      "before": [
        ["OldVerified", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp"],
        ["PendingAborted", "exchange_id", "incoming_id", "old_ctx", "discarded_ctx", "discarded_pair"],
        ["BusyEntryRead", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "rx_temp", "empty_new", "empty_pair"]
      ],
      "equal": [["rx_temp", ["tempctx", "old_ctx", "peer_pair"]]]
    },
    {
      "id": "derive_and_send",
      "kind": "correspondence",
      "before": [
        ["RestartDerived", "exchange_id", "incoming_id", "old_ctx", "peer_pair", "local_pair", "active_ctx"],
        ["ConvergentSent", "exchange_id", "incoming_id", "active_ctx"]
      ],
      "equal": [["active_ctx", ["newctx", "old_ctx", "local_pair", "peer_pair"]]]
    },
    {"id": "pair_distinct", "kind": "different", "fields": ["local_pair", "discarded_pair"]},
    {"id": "context_distinct", "kind": "different", "fields": ["active_ctx", "discarded_ctx"]}
  ]
}

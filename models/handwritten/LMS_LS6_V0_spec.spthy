  --[ Accept(I,s(s(s(z))),s(s(s(z)))) ]-> []

lemma exec: exists-trace
  "Ex I q a #s #k. Sign(I,q,a)@s & Accept(I,q,a)@k & not (Ex #r. RevealSeed(I)@r)"

// L-S1 (unforgeability): an accepted digit at leaf q was signed at leaf q.
lemma LS1:
  "All I q a #k. Accept(I,q,a)@k ==> (Ex #s. Sign(I,q,a)@s) | (Ex #r. RevealSeed(I)@r)"

// L-S6 leaf binding: an accepted signature at leaf q comes with some
// signature that the signer made at the same leaf q.
lemma LS6_bind:
  "All I q a #k. Accept(I,q,a)@k ==> (Ex b #s. Sign(I,q,b)@s) | (Ex #r. RevealSeed(I)@r)"

// L-S1 split by leaf and digit; the conjunction of these is L-S1.
lemma LS1_q0_a0:
  "All I #k. Accept(I,z,z)@k ==> (Ex #s. Sign(I,z,z)@s) | (Ex #r. RevealSeed(I)@r)"
lemma LS1_q0_a1:
  "All I #k. Accept(I,z,s(z))@k ==> (Ex #s. Sign(I,z,s(z))@s) | (Ex #r. RevealSeed(I)@r)"
lemma LS1_q0_a2:
  "All I #k. Accept(I,z,s(s(z)))@k ==> (Ex #s. Sign(I,z,s(s(z)))@s) | (Ex #r. RevealSeed(I)@r)"
lemma LS1_q0_a3:
  "All I #k. Accept(I,z,s(s(s(z))))@k ==> (Ex #s. Sign(I,z,s(s(s(z))))@s) | (Ex #r. RevealSeed(I)@r)"
lemma LS1_q1_a0:
  "All I #k. Accept(I,s(z),z)@k ==> (Ex #s. Sign(I,s(z),z)@s) | (Ex #r. RevealSeed(I)@r)"
lemma LS1_q1_a1:

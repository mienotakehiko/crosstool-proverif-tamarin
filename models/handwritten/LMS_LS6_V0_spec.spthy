rule RevealSeed:
  [ !Sk(I,sd) ] --[ RevealSeed(I) ]-> [ Out(sd) ]

// Verification completes both chains, recomputes the leaf, combines it
// with the authentication path and compares the result with the root.
rule Verify_q0_a0:
  [ !Root(I,hn(I,'1','dintr',<hn(I,'2','dintr',<hn(I,'4','dleaf',pblc(I,z,'dpblc',<ch(I,'m',ch(I,'m',ch(I,'m',sm))),sk>)),p1>),p2>)), In(<I,z,z,sm,sk,p1,p2>) ]
  --[ Accept(I,z,z) ]-> []
rule Verify_q0_a1:
  [ !Root(I,hn(I,'1','dintr',<hn(I,'2','dintr',<hn(I,'4','dleaf',pblc(I,z,'dpblc',<ch(I,'m',ch(I,'m',sm)),ch(I,'k',sk)>)),p1>),p2>)), In(<I,z,s(z),sm,sk,p1,p2>) ]
  --[ Accept(I,z,s(z)) ]-> []

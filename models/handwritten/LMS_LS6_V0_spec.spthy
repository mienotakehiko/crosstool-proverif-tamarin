  [ !Root(I,hn(I,'1','dintr',<hn(I,'2','dintr',<hn(I,'4','dleaf',pblc(I,z,'dpblc',<sm,ch(I,'k',ch(I,'k',ch(I,'k',sk)))>)),p1>),p2>)), In(<I,z,s(s(s(z))),sm,sk,p1,p2>) ]
  --[ Accept(I,z,s(s(s(z)))) ]-> []
rule Verify_q1_a0:
  [ !Root(I,hn(I,'1','dintr',<hn(I,'2','dintr',<p1,hn(I,'5','dleaf',pblc(I,s(z),'dpblc',<ch(I,'m',ch(I,'m',ch(I,'m',sm))),sk>))>),p2>)), In(<I,s(z),z,sm,sk,p1,p2>) ]
  --[ Accept(I,s(z),z) ]-> []

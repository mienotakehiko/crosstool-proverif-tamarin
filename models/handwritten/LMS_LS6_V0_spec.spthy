lemma LS1_q3_a0:
  "All I #k. Accept(I,s(s(s(z))),z)@k ==> (Ex #s. Sign(I,s(s(s(z))),z)@s) | (Ex #r. RevealSeed(I)@r)"
lemma LS1_q3_a1:

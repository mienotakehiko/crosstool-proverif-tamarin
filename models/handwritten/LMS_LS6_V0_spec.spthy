  [ St(I,s(s(z))), !Sk(I,sd), In(<'sign',s(s(z))>) ]
  --[ Sign(I,s(s(z)),s(s(z))) ]->
  [ St(I,s(s(s(z)))),
    Out(<I,s(s(z)),s(s(z)),ch(I,'m',ch(I,'m',prf(sd,s(s(z)),'m'))),ch(I,'k',prf(sd,s(s(z)),'k')),hn(I,'7','dleaf',pblc(I,s(s(s(z))),'dpblc',<ch(I,'m',ch(I,'m',ch(I,'m',prf(sd,s(s(s(z))),'m')))),ch(I,'k',ch(I,'k',ch(I,'k',prf(sd,s(s(s(z))),'k'))))>)),hn(I,'2','dintr',<hn(I,'4','dleaf',pblc(I,z,'dpblc',<ch(I,'m',ch(I,'m',ch(I,'m',prf(sd,z,'m')))),ch(I,'k',ch(I,'k',ch(I,'k',prf(sd,z,'k'))))>)),hn(I,'5','dleaf',pblc(I,s(z),'dpblc',<ch(I,'m',ch(I,'m',ch(I,'m',prf(sd,s(z),'m')))),ch(I,'k',ch(I,'k',ch(I,'k',prf(sd,s(z),'k'))))>))>)>) ]

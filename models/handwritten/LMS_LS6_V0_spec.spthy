  [ !Root(I,hn(I,'1','dintr',<hn(I,'2','dintr',<hn(I,'4','dleaf',pblc(I,z,'dpblc',<ch(I,'m',sm),ch(I,'k',ch(I,'k',sk))>)),p1>),p2>)), In(<I,z,s(s(z)),sm,sk,p1,p2>) ]
  --[ Accept(I,z,s(s(z))) ]-> []

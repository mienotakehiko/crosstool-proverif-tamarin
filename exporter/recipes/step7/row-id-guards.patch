 nonPatternGetsFilter :: LNFact -> Bool
 nonPatternGetsFilter p = isStorage p && not (hasPattern p)
 
--- | @translatePatterns facts factType filterFunction vars helperVars destructors@ applies the
+type RowReadGuards = M.Map LNTerm [LNTerm]
+
+-- | The first argument of a stamped linear fact identifies its table row.
+-- Compare it with previously bound row IDs from the same table, following
+-- the actual rendering order: pattern reads, then plain reads.
+priorRowIds :: [LNFact] -> RowReadGuards
+priorRowIds facts = snd $ foldl' remember (M.empty, M.empty) orderedReads
+  where
+    orderedReads = filter patternGetsFilter facts ++ filter nonPatternGetsFilter facts
+    remember (seen, guards) fact@(Fact tag _ (rowId : _))
+      | not (isPersistentFact fact),
+        Lit (Var (LVar name LSortFresh _)) <- viewTerm rowId,
+        name == "stL_" ++ factTagName tag =
+          let table = showFactName tag
+              previous = M.findWithDefault [] table seen
+           in (M.insert table (rowId : previous) seen, M.insert rowId (reverse previous) guards)
+    remember acc _ = acc
+
+rowReadCondition :: (Document d) => RowReadGuards -> LNFact -> d
+rowReadCondition guards fact@(Fact _ _ (rowId : _))
+  | not (isPersistentFact fact),
+    previous@(_ : _) <- M.findWithDefault [] rowId guards =
+      text (" suchthat (" ++ intercalate " && " (map unequal previous) ++ ")")
+  where
+    renderId = printTerm True S.empty False
+    unequal other = renderId rowId ++ " <> " ++ renderId other
+rowReadCondition _ _ = text ""
+
+-- | @translatePatterns rowReadGuards facts factType filterFunction vars helperVars destructors@ applies the
 --   @filterFunction@ to the @facts@ to extract those that should be translated with this call, and
 --   returns a list with translations for all those facts. @factType@ indicates what type of fact
 --   should be translated. @vars@ are all variables that have appeared in the current rule translation

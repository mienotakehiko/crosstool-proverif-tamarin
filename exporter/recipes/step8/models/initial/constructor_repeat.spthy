theory constructor_repeat begin
functions: q0/1, q1/1

rule Init:
  [ Fr(~sid) ] --[ InitOnce() ]-> [ St(~sid, q0('tag_seed'), 'phase0') ]
restriction OneInit:
  "All #i #j. InitOnce() @ i & InitOnce() @ j ==> #i = #j"
rule Good:
  [ St(sid, q0('tag_seed'), 'phase0') ] --[ Honest(sid) ]-> [ St(sid, q0('tag_seed'), 'phase1') ]
rule Bad:
  [ St(sid, q1('tag_seed'), 'phase0') ] --[ Bad(sid) ]-> []
rule Again:
  [ St(sid, q0('tag_seed'), 'phase1') ] --[ Again(sid) ]-> []
lemma honest_reachable: exists-trace
  "Ex sid #i. Honest(sid) @ i"
lemma bad_reachable: exists-trace
  "Ex sid #i. Bad(sid) @ i"
lemma repeat_reachable: exists-trace
  "Ex sid #i. Again(sid) @ i"
lemma single_consumption: all-traces
  "All sid #i #j. Honest(sid) @ i & Honest(sid) @ j ==> #i = #j"
end

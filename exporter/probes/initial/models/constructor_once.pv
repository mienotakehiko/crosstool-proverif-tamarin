free tag_seed, qdone: bitstring.
fun q0(bitstring): bitstring.
fun q1(bitstring): bitstring.
event Seed(bitstring).
event Honest(bitstring).
event Bad.
event Again.
query sid: bitstring; event(Honest(sid)).
query event(Bad).
query event(Again).
query sid: bitstring; inj-event(Honest(sid)) ==> inj-event(Seed(sid)).
process
  new state: channel;
  new sid: bitstring;
  event Seed(sid);
  (out(state, q0(tag_seed)) |
   in(state, z: bitstring);
   (if z = q0(tag_seed) then (
      event Honest(sid);
      let next = qdone in
      if next = q0(tag_seed) then event Again)
    else if z = q1(tag_seed) then event Bad))

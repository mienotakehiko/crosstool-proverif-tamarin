free qdone: bitstring.
fun z(): bitstring.
fun s(bitstring): bitstring.
event Seed(bitstring).
event Honest(bitstring).
event Bad.
event Again.
query sid: bitstring; event(Honest(sid)).
query event(Bad).
query event(Again).
query sid: bitstring; inj-event(Honest(sid)) ==> inj-event(Seed(sid)).
process
  new state: channel;
  new sid: bitstring;
  event Seed(sid);
  (out(state, z()) |
   in(state, state_value: bitstring);
   (if state_value = z() then (
      event Honest(sid);
      let next = z() in
      if next = z() then event Again)
    else if state_value = s(z()) then event Bad))

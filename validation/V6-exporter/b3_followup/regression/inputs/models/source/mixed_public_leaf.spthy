theory mixed_public_leaf begin
functions: z/0, s/1, f/1, g/1, pair/2
rule Init:
 [ Fr(~sid) ] --[ InitOnce() ]-> [ St(~sid,pair('tag',z)) ]
restriction OneInit:
 "All #i #j. InitOnce()@i & InitOnce()@j ==> #i = #j"
rule Good:
 [ St(sid,pair('tag',z)) ] --[ Good(sid) ]-> []
rule Bad:
 [ St(sid,pair('tag',s(z))) ] --[ Bad(sid) ]-> []
lemma good_reachable: exists-trace
 "Ex sid #i. Good(sid)@i"
lemma bad_reachable: exists-trace
 "Ex sid #i. Bad(sid)@i"
end

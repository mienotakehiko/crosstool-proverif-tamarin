(* R029, encoding U(1) *)
free c: channel.
const c_a, c_b, c_sa, c_sb, n0, n1: bitstring.
fun h(bitstring, bitstring): bitstring.
fun prf(bitstring, bitstring): bitstring [private].
event EvA(bitstring, bitstring, bitstring).
event EvB(bitstring, bitstring).
event Acc(bitstring, bitstring).
event RevealSeed(bitstring).
table Pk(bitstring, bitstring).

(* reachA *)
query I:bitstring, q:bitstring, a:bitstring;
  event(EvA(I, q, a)) ==> event(RevealSeed(I)).

(* uniqA *)
query I:bitstring, q:bitstring, a1:bitstring, a2:bitstring, i:time, j:time;
  event(EvA(I, q, a1))@i && event(EvA(I, q, a2))@j ==> i = j.

(* reachB *)
query I:bitstring, q:bitstring;
  event(EvB(I, q)) ==> false.

(* auth *)
query I:bitstring, a:bitstring, q:bitstring;
  event(Acc(I, a)) ==> event(EvA(I, q, a)) || event(RevealSeed(I)).

(* accept *)
query I:bitstring, a:bitstring;
  event(Acc(I, a)) ==> event(RevealSeed(I)).

(* forge *)
query I:bitstring, a:bitstring, q:bitstring;
  event(Acc(I, a)) ==> event(EvA(I, q, a)) || event(RevealSeed(I)).

let Responder() =
  !in(c, y: bitstring) [precise];
  ( (let (v_I: bitstring, (=n0, v_recv_value: bitstring)) = y in (get Pk(=v_I, =v_recv_value) in (event Acc(v_I, n0))))
  | (let (v_I: bitstring, (=n1, v_recv_value: bitstring)) = y in (get Pk(=v_I, =v_recv_value) in (event Acc(v_I, n1)))) ).

let Thread() =
  new I: bitstring; new sd: bitstring; insert Pk(I, h(I, prf(sd, c_a))); out(c, (I, h(I, prf(sd, c_a))));
  ( in(c, y: bitstring) [precise]; ((let (=c_sa, =n0) = y in ((event EvA(I, n0, n0); out(c, (I, (n0, (n0, h(I, prf(sd, c_b))))))))) | (let (=c_sa, =n1) = y in ((event EvA(I, n0, n1); out(c, (I, (n0, (n1, prf(sd, c_b)))))))) | (let (=c_sb, =n0) = y in ((event EvB(I, n0); out(c, (I, (n0, prf(sd, c_b))))))))
  | (in(c, =I); event RevealSeed(I); out(c, sd)) ).

process

(* Generated by cimc 0.1.2 from r167.toml. Do not edit. *)
(* R167, encoding U(2) *)
free c: channel.
const c_a, c_sa, n0, n1, n2: bitstring.
fun h(bitstring, bitstring): bitstring.
fun prf(bitstring, bitstring): bitstring [private].
event EvA(bitstring, bitstring).
event Acc(bitstring).
event RevealSeed(bitstring).
table Pk(bitstring, bitstring).

(* reachA *)
query I:bitstring, q:bitstring;
  event(EvA(I, q)) ==> event(RevealSeed(I)).

(* uniqA *)
query I:bitstring, q:bitstring, i:time, j:time;
  event(EvA(I, q))@i && event(EvA(I, q))@j ==> i = j.

(* auth *)
query I:bitstring, q:bitstring;
  event(Acc(I)) ==> event(EvA(I, q)) || event(RevealSeed(I)).

(* accept *)
query I:bitstring;
  event(Acc(I)) ==> event(RevealSeed(I)).

(* forge *)
query I:bitstring, q:bitstring;
  event(Acc(I)) ==> event(EvA(I, q)) || event(RevealSeed(I)).

let Responder() =
  !in(c, y: bitstring) [precise];
  ( (let (v_I: bitstring, v_recv_value: bitstring) = y in (get Pk(=v_I, =h(v_I, v_recv_value)) in (event Acc(v_I)))) ).

let Thread() =
  new I: bitstring; new sd: bitstring; insert Pk(I, h(I, h(I, prf(sd, c_a)))); out(c, (I, h(I, h(I, prf(sd, c_a)))));
  ( in(c, y: bitstring) [precise]; ((let (=c_sa, =n0) = y in ((event EvA(I, n0); out(c, (I, (n0, h(I, prf(sd, c_a))))); in(c, y: bitstring) [precise]; ((let (=c_sa, =n1) = y in ((event EvA(I, n1); out(c, (I, (n1, h(I, prf(sd, c_a)))))))))))))
  | (in(c, =I); event RevealSeed(I); out(c, sd)) ).


(* R052, encoding rep *)
free c: channel.
const c_a, c_b, c_sa, c_sb, n0, n1: bitstring.
fun h(bitstring, bitstring): bitstring.
fun prf(bitstring, bitstring): bitstring [private].
event EvA(bitstring, bitstring).
event EvB(bitstring, bitstring).
event Acc(bitstring).
event RevealSeed(bitstring).
table Pk(bitstring, bitstring).

(* reachA *)
query I:bitstring, q:bitstring;
  event(EvA(I, q)) ==> event(RevealSeed(I)).

(* uniqA *)
query I:bitstring, q:bitstring, i:time, j:time;
  event(EvA(I, q))@i && event(EvA(I, q))@j ==> i = j.

(* reachB *)
query I:bitstring, q:bitstring;
  event(EvB(I, q)) ==> false.

(* auth *)
query I:bitstring, q:bitstring;
  event(Acc(I)) ==> event(EvA(I, q)) || event(RevealSeed(I)).

(* accept *)
query I:bitstring;
  event(Acc(I)) ==> event(RevealSeed(I)).

(* forge *)
query I:bitstring, q:bitstring;
  event(Acc(I)) ==> event(EvA(I, q)) || event(RevealSeed(I)).

let Responder() =
  !in(c, y: bitstring) [precise];
  ( (let (v_I: bitstring, v_recv_value: bitstring) = y in (get Pk(=v_I, =v_recv_value) in (event Acc(v_I)))) ).

let Thread() =
  new I: bitstring; new sd: bitstring; new st: channel; insert Pk(I, h(I, h(I, prf(sd, c_a)))); out(c, (I, h(I, h(I, prf(sd, c_a)))));
  ( !out(st, n0)
  | !(in(st, x: bitstring) [precise]; in(c, y: bitstring) [precise];
       ( (let (=c_sa, =n0) = y in (if x = n0 then ((event EvA(I, n0); out(c, (I, (n0, prf(sd, c_b)))); !out(st, n1)))))
       | (let (=c_sb, =n0) = y in (if x = n0 then ((event EvB(I, n0); out(c, (I, (n0, prf(sd, c_b)))); !out(st, n1))))) ))
  | (in(c, =I); event RevealSeed(I); out(c, sd)) ).

process
  ( !Thread() | Responder() )

// At most one misuse per thread (Section 4.3).
restriction OneMisuse: "All x #i #j. Misuse(x)@#i & Misuse(x)@#j ==> #i = #j"

rule Rollback:
  [ St(I, s), !Snap(I, s0) ] --[ Misuse(I), Rollback(I, s, s0) ]-> [ St(I, s0) ]

lemma exec_accept: exists-trace
  "Ex I a1 a2 #e0 #e1. Sign(I, a1, a2)@#e0 & Accept(I, a1, a2)@#e1 & not (Ex #n0. RevealSeed(I)@#n0)"

lemma LS1_unforge:
  "All I a1 a2 #k. Accept(I, a1, a2)@#k ==> (Ex #c0_0. Sign(I, a1, a2)@#c0_0) | (Ex #c1_0. RevealSeed(I)@#c1_0)"

lemma forge: exists-trace
  "Ex I a1 a2 #e0. Accept(I, a1, a2)@#e0 & not (Ex #n0. Sign(I, a1, a2)@#n0) & not (Ex #n1. RevealSeed(I)@#n1)"


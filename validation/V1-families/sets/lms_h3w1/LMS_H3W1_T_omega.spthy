lemma exec: exists-trace
  "Ex I q a #e0 #e1. Sign(I, q, a)@#e0 & Accept(I, q, a)@#e1 & not (Ex #n0. RevealSeed(I)@#n0)"

lemma LS4_pure [use_induction]:
  "All I q a1 a2 #i #j. Sign(I, q, a1)@#i & Sign(I, q, a2)@#j ==> #i = #j"

lemma LS4 [use_induction]:
  "All I q a1 a2 #i #j. Sign(I, q, a1)@#i & Sign(I, q, a2)@#j ==> #i = #j"

lemma LS1:
  "All I q a #k. Accept(I, q, a)@#k ==> (Ex #c0_0. Sign(I, q, a)@#c0_0) | (Ex #c1_0. RevealSeed(I)@#c1_0)"

lemma LS3_forge: exists-trace
  "Ex I q a #e0. Accept(I, q, a)@#e0 & not (Ex #n0. Sign(I, q, a)@#n0) & not (Ex #n1. RevealSeed(I)@#n1)"

end

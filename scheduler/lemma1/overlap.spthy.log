theory Restricted_T_base

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, seal/1[private,constructor], snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

/* looping facts with injective instances: St/2 */

rule (modulo E) Init_Thread:
   [ Fr( ~I ) ]
  --[ Start_Thread( ~I ) ]->
   [ !Thr_Thread( ~I ), St( ~I, 'n0' ), Out( <~I, 'a'> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) First_q0:
   [ St( I, 'n0' ), !Thr_Thread( I ), In( <'a', I> ) ]
  --[ EvA( I ) ]->
   [ St( I, 'n1' ), Out( seal(I) ), Out( <'a', I> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Second_q1:
   [ St( I, 'n1' ), !Thr_Thread( I ), In( <'a', seal(I)> ) ]
  --[ EvB( I ) ]->
   [ St( I, 'n2' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Duplicate_q0:
   [ St( I, 'n0' ), !Thr_Thread( I ), In( <'a', I> ) ]
  --[ EvDup( I ) ]->
   [ St( I, 'n1' ), Out( seal(I) ), Out( <'a', I> ) ]

  /* has exactly the trivial AC variant */

lemma overlap:
  exists-trace "∃ I #e0 #e1. (EvA( I ) @ #e0) ∧ (EvDup( I ) @ #e1)"
/*
guarded formula characterizing all satisfying traces:
"∃ I #e0 #e1. (EvA( I ) @ #e0) ∧ (EvDup( I ) @ #e1)"
*/
simplify
solve( St( I, 'n0' ) ▶₀ #e0 )
  case Init_Thread
  solve( !Thr_Thread( ~I ) ▶₁ #e0 )
    case Init_Thread
    by solve( St( ~I, 'n0' ) ▶₀ #e1 )
  qed
qed


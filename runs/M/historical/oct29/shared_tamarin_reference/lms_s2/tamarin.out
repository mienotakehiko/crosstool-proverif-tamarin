lemma exec:
  exists-trace
  "∃ I q a #e0 #e1.
    ((Sign( I, q, a ) @ #e0) ∧ (Accept( I, q, a ) @ #e1)) ∧
    (¬(∃ #n0. RevealSeed( I ) @ #n0))"
/*
guarded formula characterizing all satisfying traces:
"∃ I q a #e0 #e1.
  (Sign( I, q, a ) @ #e0) ∧ (Accept( I, q, a ) @ #e1)
 ∧
  ∀ #n0. (RevealSeed( I ) @ #n0) ⇒ ⊥"
*/
simplify
solve( Sign( I, q, a ) @ #e0 )
  case Sign_q0_a0
  solve( St( I, 'n0' ) ▶₀ #e0 )
    case Init_Signer
    solve( !Thr_Signer( ~I, sd ) ▶₁ #e0 )
      case Init_Signer
      solve( Accept( ~I, 'n0', 'n0' ) @ #e1 )
        case Verify_q0_a0
        solve( !Root( ~I,
                      hl(~I, <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', sm))), sk>, sib)
               ) ▶₀ #e1 )
          case Init_Signer
          solve( !KU( prf(~sd, 'n0', 'm') ) @ #vk.8 )
            case Sign_q0_a0
            solve( !KU( ~I ) @ #vk.7 )
              case Init_Signer
              solve( !KU( ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, 'n0', 'k'))))
                     ) @ #vk.10 )
                case Sign_q0_a0
                solve( !KU( ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, 'n1', 'm'))))
                       ) @ #vk.12 )
                  case Sign_q0_a0
                  solve( !KU( ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, 'n1', 'k'))))
                         ) @ #vk.13 )
                    case Sign_q0_a0
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma LS4_pure [use_induction]:
  all-traces
  "∀ I q a1 a2 #i #j.
    ((Sign( I, q, a1 ) @ #i) ∧ (Sign( I, q, a2 ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ I q a1 a2 #i #j.
  (Sign( I, q, a1 ) @ #i) ∧ (Sign( I, q, a2 ) @ #j) ∧ ¬(#i = #j)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (#i < #j)  ∥ (#j < #i) )
    case case_1
    solve( Sign( I, q, a1 ) @ #i )
      case Sign_q0_a0

lemma LS4 [use_induction]:
  all-traces
  "∀ I q a1 a2 #i #j.
    ((Sign( I, q, a1 ) @ #i) ∧ (Sign( I, q, a2 ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ I q a1 a2 #i #j.
  (Sign( I, q, a1 ) @ #i) ∧ (Sign( I, q, a2 ) @ #j) ∧ ¬(#i = #j)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( (#i < #j)  ∥ (#j < #i) )
    case case_1
    solve( Sign( I, q, a1 ) @ #i )
      case Sign_q0_a0
      solve( St( I, 'n0' ) ▶₀ #i )
        case Init_Signer
        solve( !Thr_Signer( ~I, sd ) ▶₁ #i )
          case Init_Signer
          solve( Sign( ~I, 'n0', a2 ) @ #j )
            case Sign_q0_a0
            solve( St( ~I, 'n0' ) ▶₀ #j )
              case Init_Signer
              by contradiction /* cyclic */
            qed
          next
            case Sign_q0_a1
            by solve( St( ~I, 'n0' ) ▶₀ #j )
          next
            case Sign_q0_a2
            by solve( St( ~I, 'n0' ) ▶₀ #j )
          next
            case Sign_q0_a3
            by solve( St( ~I, 'n0' ) ▶₀ #j )
          qed
        qed
      qed
    next
      case Sign_q0_a1
      solve( St( I, 'n0' ) ▶₀ #i )
        case Init_Signer
        solve( !Thr_Signer( ~I, sd ) ▶₁ #i )
          case Init_Signer
          solve( Sign( ~I, 'n0', a2 ) @ #j )
            case Sign_q0_a0
            by solve( St( ~I, 'n0' ) ▶₀ #j )
          next
            case Sign_q0_a1
            solve( St( ~I, 'n0' ) ▶₀ #j )
              case Init_Signer
              by contradiction /* cyclic */
            qed
          next
            case Sign_q0_a2
            by solve( St( ~I, 'n0' ) ▶₀ #j )
          next
            case Sign_q0_a3
            by solve( St( ~I, 'n0' ) ▶₀ #j )
          qed
        qed
      qed
    next
      case Sign_q0_a2
      solve( St( I, 'n0' ) ▶₀ #i )
        case Init_Signer
        solve( !Thr_Signer( ~I, sd ) ▶₁ #i )
          case Init_Signer
          solve( Sign( ~I, 'n0', a2 ) @ #j )

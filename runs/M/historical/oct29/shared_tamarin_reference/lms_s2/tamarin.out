          qed
        qed
      qed
    next
      case Sign_q0_a3
      solve( St( I, 'n0' ) ▶₀ #i )
        case Init_Signer
        solve( !Thr_Signer( ~I, sd ) ▶₁ #i )
          case Init_Signer
          solve( Sign( ~I, 'n0', a2 ) @ #j )

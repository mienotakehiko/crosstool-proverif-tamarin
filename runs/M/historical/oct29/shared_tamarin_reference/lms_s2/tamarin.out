rule (modulo E) Init_Signer:
   [ Fr( ~I ), Fr( ~sd ) ]
  --[ Start_Signer( ~I ) ]->
   [
   !Thr_Signer( ~I, ~sd ), St( ~I, 'n0' ),
   !Root( ~I,
          hl(~I,
             <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, 'n0', 'm')))), 
              ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, 'n0', 'k'))))>,
             <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, 'n1', 'm')))), 
              ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, 'n1', 'k'))))>)
   ),
   Out( <~I, 
         hl(~I,
            <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, 'n0', 'm')))), 
             ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, 'n0', 'k'))))>,
            <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, 'n1', 'm')))), 

        case Sign_q0_a0
        solve( !KU( ch(~I, 'k', ch(~I, 'k', prf(~sd, 'k'))) ) @ #vk.7 )
          case c_ch
          solve( !KU( ch(~I, 'k', prf(~sd, 'k')) ) @ #vk.13 )
            case c_ch
            by solve( !KU( prf(~sd, 'k') ) @ #vk.14 )
          qed
        qed
      qed
    qed
  qed
next
  case Verify_a2
  solve( !Pk( I, <ch(I, 'm', sm), ch(I, 'k', ch(I, 'k', sk))> ) ▶₀ #k )
    case Init_Signer
    solve( !KU( ch(~I, 'm', ch(~I, 'm', prf(~sd, 'm'))) ) @ #vk.5 )

theory LMOTS_T_base

begin

// Function signature and definition of the equational theory E

functions: ch/3, fst/1, pair/2, prf/2[private,constructor], snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

/* looping facts with injective instances: St/2 */

rule (modulo E) Init_Signer:
   [ Fr( ~I ), Fr( ~sd ) ]
  --[ Start_Signer( ~I ) ]->
   [
   !Thr_Signer( ~I, ~sd ), St( ~I, 'n0' ),
   !Pk( ~I,
        <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, 'm')))), 
         ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, 'k'))))>
   ),
   Out( <~I, ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, 'm')))), 
         ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q0_a0:
   [ St( I, 'n0' ), !Thr_Signer( I, sd ), In( <'sign', 'n0'> ) ]
  --[ Sign( I, 'n0' ) ]->
   [
   St( I, 'n1' ),
   Out( <I, 'n0', prf(sd, 'm'), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q0_a1:
   [ St( I, 'n0' ), !Thr_Signer( I, sd ), In( <'sign', 'n1'> ) ]
  --[ Sign( I, 'n1' ) ]->
   [
   St( I, 'n1' ),
   Out( <I, 'n1', ch(I, 'm', prf(sd, 'm')), 
         ch(I, 'k', ch(I, 'k', prf(sd, 'k')))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q0_a2:
   [ St( I, 'n0' ), !Thr_Signer( I, sd ), In( <'sign', 'n2'> ) ]
  --[ Sign( I, 'n2' ) ]->
   [
   St( I, 'n1' ),
   Out( <I, 'n2', ch(I, 'm', ch(I, 'm', prf(sd, 'm'))), 
         ch(I, 'k', prf(sd, 'k'))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q0_a3:
   [ St( I, 'n0' ), !Thr_Signer( I, sd ), In( <'sign', 'n3'> ) ]
  --[ Sign( I, 'n3' ) ]->
   [
   St( I, 'n1' ),
   Out( <I, 'n3', ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sd, 'm')))), 
         prf(sd, 'k')>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Leak_RevealSeed:
   [ !Thr_Signer( I, sd ) ] --[ RevealSeed( I ) ]-> [ Out( sd ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_a0:
   [
   !Pk( I, <ch(I, 'm', ch(I, 'm', ch(I, 'm', sm))), sk> ),
   In( <I, 'n0', sm, sk> )
   ]
  --[ Accept( I, 'n0' ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_a1:
   [
   !Pk( I, <ch(I, 'm', ch(I, 'm', sm)), ch(I, 'k', sk)> ),
   In( <I, 'n1', sm, sk> )
   ]
  --[ Accept( I, 'n1' ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_a2:
   [
   !Pk( I, <ch(I, 'm', sm), ch(I, 'k', ch(I, 'k', sk))> ),
   In( <I, 'n2', sm, sk> )
   ]
  --[ Accept( I, 'n2' ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_a3:
   [
   !Pk( I, <sm, ch(I, 'k', ch(I, 'k', ch(I, 'k', sk)))> ),
   In( <I, 'n3', sm, sk> )
   ]
  --[ Accept( I, 'n3' ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma exec_accept:
  exists-trace
  "∃ I a #e0 #e1.
    ((Sign( I, a ) @ #e0) ∧ (Accept( I, a ) @ #e1)) ∧
    (¬(∃ #n0. RevealSeed( I ) @ #n0))"
/*
guarded formula characterizing all satisfying traces:
"∃ I a #e0 #e1.
  (Sign( I, a ) @ #e0) ∧ (Accept( I, a ) @ #e1)
 ∧
  ∀ #n0. (RevealSeed( I ) @ #n0) ⇒ ⊥"
*/
simplify
solve( Sign( I, a ) @ #e0 )
  case Sign_q0_a0
  solve( St( I, 'n0' ) ▶₀ #e0 )
    case Init_Signer
    solve( !Thr_Signer( ~I, sd ) ▶₁ #e0 )
      case Init_Signer
      solve( Accept( ~I, 'n0' ) @ #e1 )
        case Verify_a0
        solve( !Pk( ~I, <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', sm))), sk>
               ) ▶₀ #e1 )
          case Init_Signer
          solve( !KU( prf(~sd, 'm') ) @ #vk.7 )
            case Sign_q0_a0
            solve( !KU( ~I ) @ #vk.6 )
              case Init_Signer
              solve( !KU( ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, 'k'))))
                     ) @ #vk.8 )
                case Init_Signer
                SOLVED // trace found
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma LS1_unforge:
  all-traces
  "∀ I a #k.
    (Accept( I, a ) @ #k) ⇒
    ((∃ #c0_0. Sign( I, a ) @ #c0_0) ∨ (∃ #c1_0. RevealSeed( I ) @ #c1_0))"
/*
guarded formula characterizing all counter-examples:
"∃ I a #k.
  (Accept( I, a ) @ #k)
 ∧
  (∀ #c0_0. (Sign( I, a ) @ #c0_0) ⇒ ⊥) ∧
  (∀ #c1_0. (RevealSeed( I ) @ #c1_0) ⇒ ⊥)"
*/
simplify
solve( Accept( I, a ) @ #k )
  case Verify_a0
  solve( !Pk( I, <ch(I, 'm', ch(I, 'm', ch(I, 'm', sm))), sk> ) ▶₀ #k )
    case Init_Signer
    solve( !KU( prf(~sd, 'm') ) @ #vk.5 )
      case Sign_q0_a0
      by contradiction /* from formulas */
    qed
  qed
next
  case Verify_a1

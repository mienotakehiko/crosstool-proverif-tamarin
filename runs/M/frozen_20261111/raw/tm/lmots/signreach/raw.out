equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

/* looping facts with injective instances: St/2 */

rule (modulo E) Init_Signer:
   [ Fr( ~I ), Fr( ~sd ) ]
  --[ Start_Signer( ~I ), AuditSeed( ~I, ~sd ) ]->
   [
   !Thr_Signer( ~I, ~sd ), St( ~I, 'n0' ),
   !Pk( ~I,
        <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, 'm')))), 
         ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, 'k'))))>
   ),
   Out( <~I, ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, 'm')))), 
         ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q0_a0:
   [ St( I, 'n0' ), !Thr_Signer( I, sd ), In( <'sign', 'n0'> ) ]
  --[ Sign( I, 'n0' ) ]->
   [
   St( I, 'n1' ),
   Out( <I, 'n0', prf(sd, 'm'), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q0_a1:
   [ St( I, 'n0' ), !Thr_Signer( I, sd ), In( <'sign', 'n1'> ) ]
  --[ Sign( I, 'n1' ) ]->

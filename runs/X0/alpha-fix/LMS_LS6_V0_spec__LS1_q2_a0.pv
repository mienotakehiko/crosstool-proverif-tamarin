(* Events *)
event eAccept(bitstring, bitstring, bitstring).
event eDistinctFact(bitstring, bitstring).
event eKeyGen(bitstring).
event eRevealSeed(bitstring).
event eSign(bitstring, bitstring, bitstring).

(* Tables *)
table tRoot(bitstring, bitstring).
table tSk(bitstring, bitstring).
table tSt(bitstring, bitstring, bitstring).

(* Restrictions *)

(* DistinctFact *)

restriction rid_i:bitstring, rid_j:bitstring, x:bitstring, i:time,
            j:time;
  event(eDistinctFact( rid_i, x ))@i && event(eDistinctFact( rid_j, x ))@j
  ==> rid_i = rid_j.

(* Queries *)

(* LS1_q2_a0 *)


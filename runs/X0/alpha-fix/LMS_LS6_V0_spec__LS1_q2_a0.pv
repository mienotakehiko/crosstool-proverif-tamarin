set preciseActions = true.

(* Free names *)
free publicChannel:channel.
free v1:bitstring.
free v2:bitstring.
free v3:bitstring.
free v4:bitstring.
free v5:bitstring.
free v6:bitstring.
free v7:bitstring.
free vdintr:bitstring.
free vdleaf:bitstring.
free vdpblc:bitstring.
free vk:bitstring.
free vm:bitstring.
free vsign:bitstring.

(* Functions *)
fun ch(bitstring,bitstring,bitstring):bitstring.
fun fst(bitstring):bitstring.
fun hn(bitstring,bitstring,bitstring,bitstring):bitstring.
fun pair(bitstring,bitstring):bitstring.
fun pblc(bitstring,bitstring,bitstring,bitstring):bitstring.
fun prf(bitstring,bitstring,bitstring):bitstring[private].
fun s(bitstring):bitstring.
fun snd(bitstring):bitstring.
fun z():bitstring.

(* Equations *)
equation forall x_1:bitstring, x_2:bitstring; fst((x_1, x_2)) = x_1.
equation forall x_1:bitstring, x_2:bitstring; snd((x_1, x_2)) = x_2.

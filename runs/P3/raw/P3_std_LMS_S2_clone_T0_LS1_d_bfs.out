  "∀ I q a1 a2 #i #j.
    ((Sign( I, q, a1 ) @ #i) ∧ (Sign( I, q, a2 ) @ #j)) ⇒
    ((#i = #j) ∨ (∃ x #r. Clone( I, x ) @ #r))"

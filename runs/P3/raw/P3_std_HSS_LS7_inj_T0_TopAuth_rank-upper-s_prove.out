         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sdT, z, 'k')))), 
         ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sdT, s(z), 'm')))), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sdT, s(z), 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */


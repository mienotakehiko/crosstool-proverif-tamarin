set preciseActions = true.

(* Free names *)
free publicChannel:channel.
free vone:bitstring.
free vpayload:bitstring.
free vtwo:bitstring.

(* Functions *)
fun fst(bitstring):bitstring.
fun pair(bitstring,bitstring):bitstring.
fun snd(bitstring):bitstring.

(* Equations *)
equation forall x_1:bitstring, x_2:bitstring; fst((x_1, x_2)) = x_1.
equation forall x_1:bitstring, x_2:bitstring; snd((x_1, x_2)) = x_2.

(* Events *)
event eBad(bitstring).
event eDistinctFact(bitstring, bitstring).
event eGood(bitstring).
event eInitOnce(bitstring).

(* Tables *)
table tSt(bitstring, bitstring, bitstring, bitstring).

(* Restrictions *)

(* OneInit *)

restriction rid_i:bitstring, rid_j:bitstring, i:time, j:time;
  event(eInitOnce( rid_i ))@i && event(eInitOnce( rid_j ))@j
  ==> rid_i = rid_j.

(* DistinctFact *)

restriction rid_i:bitstring, rid_j:bitstring, x:bitstring, i:time,
            j:time;
  event(eDistinctFact( rid_i, x ))@i && event(eDistinctFact( rid_j, x ))@j
  ==> rid_i = rid_j.

(* Queries *)

(* good_reachable *)

query asid:bitstring, i:time; event(eGood( asid ))@i.

(* Processes *)

let rInit =
        new rid_rInit: bitstring;
        new stR_St: bitstring;
        new stR_St_1: bitstring;
        new stR_St_2: bitstring;
        new asid: bitstring;
        event eInitOnce(rid_rInit);
        insert tSt(stR_St, asid, vtwo, vpayload);
        insert tSt(stR_St_1, asid, vtwo, vpayload);
        insert tSt(stR_St_2, asid, vone, vpayload).

let rGood =
        get tSt(stL_St, asid, =vtwo, =vpayload) in
        get tSt(stL_St_1, =asid, =vtwo,
                =vpayload) suchthat (stL_St_1 <> stL_St) in
        new rid_rGood: bitstring;
        event eDistinctFact(rid_rGood, (stL_St, (asid, (vtwo, vpayload))));
        event eDistinctFact(rid_rGood, (stL_St_1, (asid, (vtwo, vpayload))));
        event eGood(asid).

let rBad =
        get tSt(stL_St, asid, =vone, =vpayload) in
        get tSt(stL_St_1, =asid, =vone,
                =vpayload) suchthat (stL_St_1 <> stL_St) in
        new rid_rBad: bitstring;
        event eDistinctFact(rid_rBad, (stL_St, (asid, (vone, vpayload))));
        event eDistinctFact(rid_rBad, (stL_St_1, (asid, (vone, vpayload))));
        event eBad(asid).

process
    ( !(rInit) | !(rGood) | !(rBad) )

(*
All wellformedness checks were successful.
*)


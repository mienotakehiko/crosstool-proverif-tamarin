theory linear_mixed begin
functions: z/0

rule Init:
  [ Fr(~sid) ] --[ InitOnce() ]->
  [ St(~sid, 'two', z), St(~sid, 'two', 'other'), St(~sid, 'one', z) ]

restriction OneInit:
  "All #i #j. InitOnce() @ i & InitOnce() @ j ==> #i = #j"

rule Good:
  [ St(sid, 'two', value), St(sid, 'two', z) ] --[ Good(sid) ]-> []

rule Bad:
  [ St(sid, 'one', value), St(sid, 'one', z) ] --[ Bad(sid) ]-> []

lemma good_reachable: exists-trace
  "Ex sid #i. Good(sid) @ i"

lemma bad_reachable: exists-trace
  "Ex sid #i. Bad(sid) @ i"
end

set preciseActions = true.

(* Free names *)
free publicChannel:channel.
free vempty_local_pair:bitstring.
free vempty_oldest_parent:bitstring.
free vempty_oldest_temp:bitstring.
free vempty_pending_new:bitstring.

(* Functions *)
fun fst(bitstring):bitstring.
fun newctx(bitstring,bitstring,bitstring):bitstring.
fun pair(bitstring,bitstring):bitstring.
fun snd(bitstring):bitstring.
fun tempctx(bitstring,bitstring):bitstring.

(* Equations *)
equation forall x_1:bitstring, x_2:bitstring; fst((x_1, x_2)) = x_1.
equation forall x_1:bitstring, x_2:bitstring; snd((x_1, x_2)) = x_2.

(* Events *)
event eBusyEntryRead(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event eConvergentSent(bitstring, bitstring, bitstring).
event eDistinctFact(bitstring, bitstring).
event eInit(bitstring).
event eNewVerified(bitstring, bitstring, bitstring, bitstring, bitstring).
event ePendingAborted(bitstring, bitstring, bitstring, bitstring, bitstring).
event ePendingBefore(bitstring, bitstring, bitstring, bitstring).
event ePendingRead(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event eRestartDerived(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event eVerifiedTempMatches(bitstring, bitstring).

(* Tables *)
table tBeforeSnapshot(bitstring, bitstring, bitstring, bitstring, bitstring).
table tBusyEntry(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
table tBusyReady(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
table tPending(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
table tPendingAfter(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
table tReadyToSend(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
table tVerifiedDivergent(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
table tVerifiedNewOnlyPremise(bitstring, bitstring, bitstring, bitstring, bitstring).

(* Restrictions *)

(* SingleInit *)

restriction rid_i:bitstring, rid_j:bitstring, i:time, j:time;
  event(eInit( rid_i ))@i && event(eInit( rid_j ))@j ==> rid_i = rid_j.

(* VerifiedTemporaryContext *)

restriction a:bitstring, b:bitstring, i:time;
  event(eVerifiedTempMatches( a, b ))@i ==> a = b.

(* DistinctFact *)

restriction rid_i:bitstring, rid_j:bitstring, x:bitstring, i:time,
            j:time;
  event(eDistinctFact( rid_i, x ))@i && event(eDistinctFact( rid_j, x ))@j
  ==> rid_i = rid_j.

(* Queries *)

(* t7_continuation_reachable *)

query active_ctx:bitstring, exchange_id:bitstring, incoming_id:bitstring,
      local_pair:bitstring, oldest_parent:bitstring, oldest_temp:bitstring,
      peer_pair:bitstring, prior_new:bitstring, promoted:bitstring,
      rx_temp:bitstring, k:time;
  event(ePendingRead( exchange_id, incoming_id, promoted, peer_pair,
                      local_pair, active_ctx, prior_new, oldest_parent, oldest_temp, rx_temp
        ))@k.

(* Processes *)

let rInit =
        new rid_rInit: bitstring;
        new stR_Pending: bitstring;
        new stR_BeforeSnapshot: bitstring;
        new stR_VerifiedNewOnlyPremise: bitstring;
        new exchange_id: bitstring;
        new prior_new: bitstring;
        new oldest_parent: bitstring;
        new oldest_pair: bitstring;
        new incoming_pair: bitstring;
        new incoming_id: bitstring;
        event eInit(rid_rInit);
        event ePendingBefore(exchange_id, prior_new, oldest_parent,
                             tempctx(oldest_parent, oldest_pair));
        insert tPending(stR_Pending, exchange_id, prior_new, oldest_parent,
                        tempctx(oldest_parent, oldest_pair), vempty_local_pair);
        insert tBeforeSnapshot(stR_BeforeSnapshot, exchange_id, prior_new,
                               oldest_parent, tempctx(oldest_parent, oldest_pair));
        insert tVerifiedNewOnlyPremise(stR_VerifiedNewOnlyPremise, exchange_id,
                                       incoming_id, prior_new, incoming_pair).

let rRecordVerifiedReceipt =
        get tVerifiedNewOnlyPremise(stL_VerifiedNewOnlyPremise, exchange_id,
                                    incoming_id, prior_new, peer_pair) in
        new rid_rRecordVerifiedReceipt: bitstring;
        new stR_VerifiedDivergent: bitstring;
        event eDistinctFact(rid_rRecordVerifiedReceipt, (stL_VerifiedNewOnlyPremise, (exchange_id, (incoming_id, (prior_new, peer_pair)))));
        event eNewVerified(exchange_id, incoming_id, prior_new, peer_pair,
                           tempctx(prior_new, peer_pair));
        insert tVerifiedDivergent(stR_VerifiedDivergent, exchange_id,
                                  incoming_id, prior_new, peer_pair, tempctx(prior_new, peer_pair)).

let rAbortAndPromote =
        get tPending(stL_Pending, exchange_id, prior_new, oldest_parent,
                     oldest_temp, local_slot) in
        get tVerifiedDivergent(stL_VerifiedDivergent, =exchange_id, incoming_id,
                               =prior_new, peer_pair, rx_temp) in
        new rid_rAbortAndPromote: bitstring;
        new stR_BusyEntry: bitstring;
        event eDistinctFact(rid_rAbortAndPromote, (stL_Pending, (exchange_id, (prior_new, (oldest_parent, (oldest_temp, local_slot))))));
        event eDistinctFact(rid_rAbortAndPromote, (stL_VerifiedDivergent, (exchange_id, (incoming_id, (prior_new, (peer_pair, rx_temp))))));
        event ePendingAborted(exchange_id, incoming_id, prior_new, oldest_parent,
                              oldest_temp);
        event eVerifiedTempMatches(rx_temp, tempctx(prior_new, peer_pair));
        insert tBusyEntry(stR_BusyEntry, exchange_id, incoming_id, prior_new,
                          peer_pair, rx_temp, vempty_oldest_temp, vempty_oldest_parent,
                          vempty_pending_new, local_slot).

let rReadBusyEntry =
        get tBusyEntry(stL_BusyEntry, exchange_id, incoming_id, promoted,
                       peer_pair, rx_temp, temp_slot, parent_slot, new_slot, local_slot) in
        new rid_rReadBusyEntry: bitstring;
        new stR_BusyReady: bitstring;
        event eDistinctFact(rid_rReadBusyEntry, (stL_BusyEntry, (exchange_id, (incoming_id, (promoted, (peer_pair, (rx_temp, (temp_slot, (parent_slot, (new_slot, local_slot))))))))));
        event eBusyEntryRead(exchange_id, incoming_id, promoted, peer_pair,
                             rx_temp, temp_slot, parent_slot, new_slot, local_slot);
        insert tBusyReady(stR_BusyReady, exchange_id, incoming_id, promoted,
                          peer_pair, rx_temp, temp_slot, parent_slot, new_slot, local_slot).

let rDeriveNewContext =
        get tBusyReady(stL_BusyReady, exchange_id, incoming_id, promoted,
                       peer_pair, rx_temp, =vempty_oldest_temp, =vempty_oldest_parent,
                       =vempty_pending_new, =vempty_local_pair) in
        new rid_rDeriveNewContext: bitstring;
        new stR_ReadyToSend: bitstring;
        new fresh_local_pair: bitstring;
        event eDistinctFact(rid_rDeriveNewContext, (stL_BusyReady, (exchange_id, (incoming_id, (promoted, (peer_pair, (rx_temp, (vempty_oldest_temp, (vempty_oldest_parent, (vempty_pending_new, vempty_local_pair))))))))));
        event eRestartDerived(exchange_id, incoming_id, promoted, peer_pair,
                              fresh_local_pair, newctx(promoted, fresh_local_pair, peer_pair));
        insert tReadyToSend(stR_ReadyToSend, exchange_id, incoming_id, promoted,
                            peer_pair, rx_temp, fresh_local_pair,
                            newctx(promoted, fresh_local_pair, peer_pair)).

let rSendConvergent =
        get tReadyToSend(stL_ReadyToSend, exchange_id, incoming_id, promoted,
                         peer_pair, rx_temp, local_pair, active_ctx) in
        new rid_rSendConvergent: bitstring;
        new stR_PendingAfter: bitstring;
        event eDistinctFact(rid_rSendConvergent, (stL_ReadyToSend, (exchange_id, (incoming_id, (promoted, (peer_pair, (rx_temp, (local_pair, active_ctx))))))));
        event eConvergentSent(exchange_id, incoming_id, active_ctx);
        insert tPendingAfter(stR_PendingAfter, exchange_id, incoming_id,
                             promoted, peer_pair, rx_temp, local_pair, active_ctx).

let rReadPending =
        get tPendingAfter(stL_PendingAfter, exchange_id, incoming_id, promoted,
                          peer_pair, rx_temp, local_pair, active_ctx) in
        get tBeforeSnapshot(stL_BeforeSnapshot, =exchange_id, prior_new,
                            oldest_parent, oldest_temp) in
        new rid_rReadPending: bitstring;
        event eDistinctFact(rid_rReadPending, (stL_PendingAfter, (exchange_id, (incoming_id, (promoted, (peer_pair, (rx_temp, (local_pair, active_ctx))))))));
        event eDistinctFact(rid_rReadPending, (stL_BeforeSnapshot, (exchange_id, (prior_new, (oldest_parent, oldest_temp)))));
        event ePendingRead(exchange_id, incoming_id, promoted, peer_pair,
                           local_pair, active_ctx, prior_new, oldest_parent, oldest_temp, rx_temp).

process
    ( !(rInit) | !(rRecordVerifiedReceipt) | !(rAbortAndPromote) | !(rReadBusyEntry) | !(rDeriveNewContext) | !(rSendConvergent) | !(rReadPending) )

(*
All wellformedness checks were successful.
*)


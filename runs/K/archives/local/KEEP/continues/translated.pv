set preciseActions = true.

(* Free names *)
free publicChannel:channel.

(* Functions *)
fun fst(bitstring):bitstring.
fun pair(bitstring,bitstring):bitstring.
fun snd(bitstring):bitstring.
fun succ(bitstring):bitstring.

(* Equations *)
equation forall x_1:bitstring, x_2:bitstring; fst((x_1, x_2)) = x_1.
equation forall x_1:bitstring, x_2:bitstring; snd((x_1, x_2)) = x_2.

(* Events *)
event eBusyBefore(bitstring, bitstring).
event eBusyKept(bitstring, bitstring).
event eDistinctFact(bitstring, bitstring).
event eInit(bitstring).

(* Tables *)
table tBusyUsable(bitstring, bitstring, bitstring).

(* Restrictions *)

(* SingleInit *)

restriction rid_i:bitstring, rid_j:bitstring, i:time, j:time;
  event(eInit( rid_i ))@i && event(eInit( rid_j ))@j ==> rid_i = rid_j.

(* DistinctFact *)

restriction rid_i:bitstring, rid_j:bitstring, x:bitstring, i:time,
            j:time;
  event(eDistinctFact( rid_i, x ))@i && event(eDistinctFact( rid_j, x ))@j
  ==> rid_i = rid_j.

(* Queries *)

(* busy_keep_continues *)

query c:bitstring, n:bitstring, p:bitstring, k:time, t1:time;
  event(eBusyKept( c, n ))@k
  ==> event(eBusyBefore( c, p ))@t1 && t1 < k && n = succ(p).

(* Processes *)

let rInit =
        new rid_rInit: bitstring;
        new stR_BusyUsable: bitstring;
        new initial_context: bitstring;
        new initial_counter: bitstring;
        event eInit(rid_rInit);
        event eBusyBefore(initial_context, initial_counter);
        insert tBusyUsable(stR_BusyUsable, initial_context, initial_counter).

let rKeep =
        get tBusyUsable(stL_BusyUsable, c, p) in
        new rid_rKeep: bitstring;
        event eDistinctFact(rid_rKeep, (stL_BusyUsable, (c, p)));
        event eBusyKept(c, succ(p)).

process
    ( !(rInit) | !(rKeep) )

(*
All wellformedness checks were successful.
*)


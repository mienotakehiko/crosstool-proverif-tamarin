// Generated pending_new case. Verification result is a local premise.
theory CimPendingNew
begin

functions: tempctx/2

rule Init:
  [ Fr(~old_ctx), Fr(~new_ctx), Fr(~oldest_pair), Fr(~incoming_pair), Fr(~message) ]
  --[ Init(), PendingBefore(~new_ctx,~old_ctx,tempctx(~old_ctx,~oldest_pair)) ]->
  [ Pending(~new_ctx,~old_ctx,tempctx(~old_ctx,~oldest_pair)), BeforeSnapshot(~new_ctx,~old_ctx,tempctx(~old_ctx,~oldest_pair)), VerifiedNewOnlyPremise(~message,~new_ctx,~incoming_pair) ]

rule RecordVerifiedReceipt:
  [ VerifiedNewOnlyPremise(m,n,peer_pair) ]
  --[ NewVerified(m,n,tempctx(n,peer_pair)) ]->
  [ VerifiedDivergent(m,n,tempctx(n,peer_pair),peer_pair) ]

rule AbortOnNewDerived:
  [ Pending(n,b,t0), VerifiedDivergent(m,n,r,peer_pair) ]
  --[ PendingAborted(m,n,b,t0), VerifiedTempMatches(r,tempctx(n,peer_pair)) ]->
  [ BusyEntry(m,n,r,'empty_oldest_temp','empty_oldest_parent','empty_pending_new') ]

rule ReadBusyEntry:
  [ BeforeSnapshot(n0,b0,t0), BusyEntry(m,o,r,st,sp,sn) ]
  --[ BusyEntryRead(m,o,r,n0,b0,t0,st,sp,sn) ]->
  [  ]

restriction SingleInit:
  "All #i #j. Init()@i & Init()@j ==> #i = #j"

restriction VerifiedTemporaryContext:
  "All a b #i. VerifiedTempMatches(a,b)@i ==> a = b"

lemma pending_new_reachable: exists-trace
  "Ex m o r n0 b0 t0 st sp sn #k. BusyEntryRead(m,o,r,n0,b0,t0,st,sp,sn)@k"

lemma pending_new_receipt_and_promotion:
  "All m o r n0 b0 t0 st sp sn #k. BusyEntryRead(m,o,r,n0,b0,t0,st,sp,sn)@k ==>
    Ex #t1. NewVerified(m,n0,r)@t1 & #t1 < #k & o = n0"

lemma pending_new_aborts_matching_update:
  "All m o r n0 b0 t0 st sp sn #k. BusyEntryRead(m,o,r,n0,b0,t0,st,sp,sn)@k ==>
    Ex #t1 #t2. PendingBefore(n0,b0,t0)@t1 & PendingAborted(m,n0,b0,t0)@t2 & #t1 < #k & #t2 < #k"

lemma pending_new_slots_empty:
  "All m o r n0 b0 t0 st sp sn #k. BusyEntryRead(m,o,r,n0,b0,t0,st,sp,sn)@k ==>
    st = 'empty_oldest_temp' & sp = 'empty_oldest_parent' & sn = 'empty_pending_new'"

end

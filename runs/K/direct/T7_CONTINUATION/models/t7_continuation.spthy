// Generated t7_continuation case. Verification result is a local premise.
theory CimT7Continuation
begin

functions: tempctx/2, newctx/3

rule Init:
  [ Fr(~exchange_id), Fr(~prior_new), Fr(~oldest_parent), Fr(~oldest_pair), Fr(~incoming_pair), Fr(~incoming_id) ]
  --[ Init(), PendingBefore(~exchange_id,~prior_new,~oldest_parent,tempctx(~oldest_parent,~oldest_pair)) ]->
  [ Pending(~exchange_id,~prior_new,~oldest_parent,tempctx(~oldest_parent,~oldest_pair),'empty_local_pair'), BeforeSnapshot(~exchange_id,~prior_new,~oldest_parent,tempctx(~oldest_parent,~oldest_pair)), VerifiedNewOnlyPremise(~exchange_id,~incoming_id,~prior_new,~incoming_pair) ]

rule RecordVerifiedReceipt:
  [ VerifiedNewOnlyPremise(exchange_id,incoming_id,prior_new,peer_pair) ]
  --[ NewVerified(exchange_id,incoming_id,prior_new,peer_pair,tempctx(prior_new,peer_pair)) ]->
  [ VerifiedDivergent(exchange_id,incoming_id,prior_new,peer_pair,tempctx(prior_new,peer_pair)) ]

rule AbortAndPromote:
  [ Pending(exchange_id,prior_new,oldest_parent,oldest_temp,local_slot), VerifiedDivergent(exchange_id,incoming_id,prior_new,peer_pair,rx_temp) ]
  --[ PendingAborted(exchange_id,incoming_id,prior_new,oldest_parent,oldest_temp), VerifiedTempMatches(rx_temp,tempctx(prior_new,peer_pair)) ]->
  [ BusyEntry(exchange_id,incoming_id,prior_new,peer_pair,rx_temp,'empty_oldest_temp','empty_oldest_parent','empty_pending_new',local_slot) ]

rule ReadBusyEntry:
  [ BusyEntry(exchange_id,incoming_id,promoted,peer_pair,rx_temp,temp_slot,parent_slot,new_slot,local_slot) ]
  --[ BusyEntryRead(exchange_id,incoming_id,promoted,peer_pair,rx_temp,temp_slot,parent_slot,new_slot,local_slot) ]->
  [ BusyReady(exchange_id,incoming_id,promoted,peer_pair,rx_temp,temp_slot,parent_slot,new_slot,local_slot) ]

rule DeriveNewContext:
  [ Fr(~fresh_local_pair), BusyReady(exchange_id,incoming_id,promoted,peer_pair,rx_temp,'empty_oldest_temp','empty_oldest_parent','empty_pending_new','empty_local_pair') ]
  --[ RestartDerived(exchange_id,incoming_id,promoted,peer_pair,~fresh_local_pair,newctx(promoted,~fresh_local_pair,peer_pair)) ]->
  [ ReadyToSend(exchange_id,incoming_id,promoted,peer_pair,rx_temp,~fresh_local_pair,newctx(promoted,~fresh_local_pair,peer_pair)) ]

rule SendConvergent:
  [ ReadyToSend(exchange_id,incoming_id,promoted,peer_pair,rx_temp,local_pair,active_ctx) ]
  --[ ConvergentSent(exchange_id,incoming_id,active_ctx) ]->
  [ PendingAfter(exchange_id,incoming_id,promoted,peer_pair,rx_temp,local_pair,active_ctx) ]

rule ReadPending:
  [ PendingAfter(exchange_id,incoming_id,promoted,peer_pair,rx_temp,local_pair,active_ctx), BeforeSnapshot(exchange_id,prior_new,oldest_parent,oldest_temp) ]
  --[ PendingRead(exchange_id,incoming_id,promoted,peer_pair,local_pair,active_ctx,prior_new,oldest_parent,oldest_temp,rx_temp) ]->
  [  ]

restriction SingleInit:
  "All #i #j. Init()@i & Init()@j ==> #i = #j"

restriction VerifiedTemporaryContext:
  "All a b #i. VerifiedTempMatches(a,b)@i ==> a = b"

lemma t7_continuation_reachable: exists-trace
  "Ex exchange_id incoming_id promoted peer_pair local_pair active_ctx prior_new oldest_parent oldest_temp rx_temp #k. PendingRead(exchange_id,incoming_id,promoted,peer_pair,local_pair,active_ctx,prior_new,oldest_parent,oldest_temp,rx_temp)@k"

lemma t7_continuation_new_receipt_and_promotion:
  "All exchange_id incoming_id promoted peer_pair local_pair active_ctx prior_new oldest_parent oldest_temp rx_temp #k. PendingRead(exchange_id,incoming_id,promoted,peer_pair,local_pair,active_ctx,prior_new,oldest_parent,oldest_temp,rx_temp)@k ==>
    Ex #t1 #t2 #t3 #t4. PendingBefore(exchange_id,prior_new,oldest_parent,oldest_temp)@t1 & NewVerified(exchange_id,incoming_id,prior_new,peer_pair,rx_temp)@t2 & PendingAborted(exchange_id,incoming_id,prior_new,oldest_parent,oldest_temp)@t3 & BusyEntryRead(exchange_id,incoming_id,promoted,peer_pair,rx_temp,'empty_oldest_temp','empty_oldest_parent','empty_pending_new','empty_local_pair')@t4 & #t1 < #t2 & #t2 < #t3 & #t3 < #t4 & #t4 < #k & promoted = prior_new & rx_temp = tempctx(prior_new,peer_pair)"

lemma t7_continuation_derive_and_send:
  "All exchange_id incoming_id promoted peer_pair local_pair active_ctx prior_new oldest_parent oldest_temp rx_temp #k. PendingRead(exchange_id,incoming_id,promoted,peer_pair,local_pair,active_ctx,prior_new,oldest_parent,oldest_temp,rx_temp)@k ==>
    Ex #t1 #t2. RestartDerived(exchange_id,incoming_id,promoted,peer_pair,local_pair,active_ctx)@t1 & ConvergentSent(exchange_id,incoming_id,active_ctx)@t2 & #t1 < #t2 & #t2 < #k & active_ctx = newctx(promoted,local_pair,peer_pair)"

lemma t7_continuation_parent_distinct:
  "All exchange_id incoming_id promoted peer_pair local_pair active_ctx prior_new oldest_parent oldest_temp rx_temp #k. PendingRead(exchange_id,incoming_id,promoted,peer_pair,local_pair,active_ctx,prior_new,oldest_parent,oldest_temp,rx_temp)@k ==> not(promoted = oldest_parent)"

lemma t7_continuation_context_distinct:
  "All exchange_id incoming_id promoted peer_pair local_pair active_ctx prior_new oldest_parent oldest_temp rx_temp #k. PendingRead(exchange_id,incoming_id,promoted,peer_pair,local_pair,active_ctx,prior_new,oldest_parent,oldest_temp,rx_temp)@k ==> not(active_ctx = prior_new)"

end

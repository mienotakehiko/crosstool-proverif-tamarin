(* Generated t7_continuation case. Verification result is a local premise. *)
free ch_Pending, ch_BeforeSnapshot, ch_VerifiedNewOnlyPremise, ch_VerifiedDivergent, ch_BusyEntry, ch_BusyReady, ch_ReadyToSend, ch_PendingAfter: channel [private].
free empty_oldest_temp, empty_oldest_parent, empty_pending_new, empty_local_pair: bitstring.
fun tempctx(bitstring, bitstring): bitstring.
fun newctx(bitstring, bitstring, bitstring): bitstring.

event PendingBefore(bitstring, bitstring, bitstring, bitstring).
event NewVerified(bitstring, bitstring, bitstring, bitstring, bitstring).
event PendingAborted(bitstring, bitstring, bitstring, bitstring, bitstring).
event BusyEntryRead(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event RestartDerived(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).
event ConvergentSent(bitstring, bitstring, bitstring).
event PendingRead(bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring, bitstring).

query q1_exchange_id:bitstring, q1_incoming_id:bitstring, q1_promoted:bitstring, q1_peer_pair:bitstring, q1_local_pair:bitstring, q1_active_ctx:bitstring, q1_prior_new:bitstring, q1_oldest_parent:bitstring, q1_oldest_temp:bitstring, q1_rx_temp:bitstring;
  event(PendingRead(q1_exchange_id,q1_incoming_id,q1_promoted,q1_peer_pair,q1_local_pair,q1_active_ctx,q1_prior_new,q1_oldest_parent,q1_oldest_temp,q1_rx_temp)).

query q2_exchange_id:bitstring, q2_incoming_id:bitstring, q2_promoted:bitstring, q2_peer_pair:bitstring, q2_local_pair:bitstring, q2_active_ctx:bitstring, q2_prior_new:bitstring, q2_oldest_parent:bitstring, q2_oldest_temp:bitstring, q2_rx_temp:bitstring;
  event(PendingRead(q2_exchange_id,q2_incoming_id,q2_promoted,q2_peer_pair,q2_local_pair,q2_active_ctx,q2_prior_new,q2_oldest_parent,q2_oldest_temp,q2_rx_temp)) ==> event(PendingBefore(q2_exchange_id,q2_prior_new,q2_oldest_parent,q2_oldest_temp)) && event(NewVerified(q2_exchange_id,q2_incoming_id,q2_prior_new,q2_peer_pair,q2_rx_temp)) && event(PendingAborted(q2_exchange_id,q2_incoming_id,q2_prior_new,q2_oldest_parent,q2_oldest_temp)) && event(BusyEntryRead(q2_exchange_id,q2_incoming_id,q2_promoted,q2_peer_pair,q2_rx_temp,empty_oldest_temp,empty_oldest_parent,empty_pending_new,empty_local_pair)) && q2_promoted = q2_prior_new && q2_rx_temp = tempctx(q2_prior_new,q2_peer_pair).

query q3_exchange_id:bitstring, q3_incoming_id:bitstring, q3_promoted:bitstring, q3_peer_pair:bitstring, q3_local_pair:bitstring, q3_active_ctx:bitstring, q3_prior_new:bitstring, q3_oldest_parent:bitstring, q3_oldest_temp:bitstring, q3_rx_temp:bitstring;
  event(PendingRead(q3_exchange_id,q3_incoming_id,q3_promoted,q3_peer_pair,q3_local_pair,q3_active_ctx,q3_prior_new,q3_oldest_parent,q3_oldest_temp,q3_rx_temp)) ==> event(RestartDerived(q3_exchange_id,q3_incoming_id,q3_promoted,q3_peer_pair,q3_local_pair,q3_active_ctx)) && event(ConvergentSent(q3_exchange_id,q3_incoming_id,q3_active_ctx)) && q3_active_ctx = newctx(q3_promoted,q3_local_pair,q3_peer_pair).

query q4_exchange_id:bitstring, q4_incoming_id:bitstring, q4_oldest_parent:bitstring, q4_peer_pair:bitstring, q4_local_pair:bitstring, q4_active_ctx:bitstring, q4_prior_new:bitstring, q4_oldest_temp:bitstring, q4_rx_temp:bitstring;
  event(PendingRead(q4_exchange_id,q4_incoming_id,q4_oldest_parent,q4_peer_pair,q4_local_pair,q4_active_ctx,q4_prior_new,q4_oldest_parent,q4_oldest_temp,q4_rx_temp)).

query q5_exchange_id:bitstring, q5_incoming_id:bitstring, q5_promoted:bitstring, q5_peer_pair:bitstring, q5_local_pair:bitstring, q5_prior_new:bitstring, q5_oldest_parent:bitstring, q5_oldest_temp:bitstring, q5_rx_temp:bitstring;
  event(PendingRead(q5_exchange_id,q5_incoming_id,q5_promoted,q5_peer_pair,q5_local_pair,q5_prior_new,q5_prior_new,q5_oldest_parent,q5_oldest_temp,q5_rx_temp)).

process
  new exchange_id:bitstring;
  new prior_new:bitstring;
  new oldest_parent:bitstring;
  new oldest_pair:bitstring;
  new incoming_pair:bitstring;
  new incoming_id:bitstring;
  event PendingBefore(exchange_id,prior_new,oldest_parent,tempctx(oldest_parent,oldest_pair));
  (
    (out(ch_Pending,(exchange_id,prior_new,oldest_parent,tempctx(oldest_parent,oldest_pair),empty_local_pair));
     0)
    |
    (out(ch_BeforeSnapshot,(exchange_id,prior_new,oldest_parent,tempctx(oldest_parent,oldest_pair)));
     0)
    |
    (out(ch_VerifiedNewOnlyPremise,(exchange_id,incoming_id,prior_new,incoming_pair));
     0)
    |
    (in(ch_VerifiedNewOnlyPremise,(exchange_id_s1:bitstring,incoming_id_s1:bitstring,prior_new_s1:bitstring,peer_pair_s1:bitstring));
     event NewVerified(exchange_id_s1,incoming_id_s1,prior_new_s1,peer_pair_s1,tempctx(prior_new_s1,peer_pair_s1));
     out(ch_VerifiedDivergent,(exchange_id_s1,incoming_id_s1,prior_new_s1,peer_pair_s1,tempctx(prior_new_s1,peer_pair_s1)));
     0)
    |
    (in(ch_Pending,(exchange_id_s2:bitstring,prior_new_s2:bitstring,oldest_parent_s2:bitstring,oldest_temp_s2:bitstring,local_slot_s2:bitstring));
     in(ch_VerifiedDivergent,(=exchange_id_s2,incoming_id_s2:bitstring,=prior_new_s2,peer_pair_s2:bitstring,rx_temp_s2:bitstring));
     if rx_temp_s2 = tempctx(prior_new_s2,peer_pair_s2) then
       (event PendingAborted(exchange_id_s2,incoming_id_s2,prior_new_s2,oldest_parent_s2,oldest_temp_s2);
        out(ch_BusyEntry,(exchange_id_s2,incoming_id_s2,prior_new_s2,peer_pair_s2,rx_temp_s2,empty_oldest_temp,empty_oldest_parent,empty_pending_new,local_slot_s2));
        0))
    |
    (in(ch_BusyEntry,(exchange_id_s3:bitstring,incoming_id_s3:bitstring,promoted_s3:bitstring,peer_pair_s3:bitstring,rx_temp_s3:bitstring,temp_slot_s3:bitstring,parent_slot_s3:bitstring,new_slot_s3:bitstring,local_slot_s3:bitstring));
     event BusyEntryRead(exchange_id_s3,incoming_id_s3,promoted_s3,peer_pair_s3,rx_temp_s3,temp_slot_s3,parent_slot_s3,new_slot_s3,local_slot_s3);
     out(ch_BusyReady,(exchange_id_s3,incoming_id_s3,promoted_s3,peer_pair_s3,rx_temp_s3,temp_slot_s3,parent_slot_s3,new_slot_s3,local_slot_s3));
     0)
    |
    (in(ch_BusyReady,(exchange_id_s4:bitstring,incoming_id_s4:bitstring,promoted_s4:bitstring,peer_pair_s4:bitstring,rx_temp_s4:bitstring,=empty_oldest_temp,=empty_oldest_parent,=empty_pending_new,=empty_local_pair));
     new fresh_local_pair_s4:bitstring;
     event RestartDerived(exchange_id_s4,incoming_id_s4,promoted_s4,peer_pair_s4,fresh_local_pair_s4,newctx(promoted_s4,fresh_local_pair_s4,peer_pair_s4));
     out(ch_ReadyToSend,(exchange_id_s4,incoming_id_s4,promoted_s4,peer_pair_s4,rx_temp_s4,fresh_local_pair_s4,newctx(promoted_s4,fresh_local_pair_s4,peer_pair_s4)));
     0)
    |
    (in(ch_ReadyToSend,(exchange_id_s5:bitstring,incoming_id_s5:bitstring,promoted_s5:bitstring,peer_pair_s5:bitstring,rx_temp_s5:bitstring,local_pair_s5:bitstring,active_ctx_s5:bitstring));
     event ConvergentSent(exchange_id_s5,incoming_id_s5,active_ctx_s5);
     out(ch_PendingAfter,(exchange_id_s5,incoming_id_s5,promoted_s5,peer_pair_s5,rx_temp_s5,local_pair_s5,active_ctx_s5));
     0)
    |
    (in(ch_PendingAfter,(exchange_id_s6:bitstring,incoming_id_s6:bitstring,promoted_s6:bitstring,peer_pair_s6:bitstring,rx_temp_s6:bitstring,local_pair_s6:bitstring,active_ctx_s6:bitstring));
     in(ch_BeforeSnapshot,(=exchange_id_s6,prior_new_s6:bitstring,oldest_parent_s6:bitstring,oldest_temp_s6:bitstring));
     event PendingRead(exchange_id_s6,incoming_id_s6,promoted_s6,peer_pair_s6,local_pair_s6,active_ctx_s6,prior_new_s6,oldest_parent_s6,oldest_temp_s6,rx_temp_s6);
     0)
  )

lemma aliveness:
  exists-trace
  "∃ s I_s I_r n1 n2 #i. (R3( s, I_s, I_r, n1, n2 ) @ #i) ∧ (¬(I_s = I_r))"
/*
guarded formula characterizing all satisfying traces:
"∃ s I_s I_r n1 n2 #i. (R3( s, I_s, I_r, n1, n2 ) @ #i) ∧ ¬(I_s = I_r)"
*/
simplify
solve( I1( n1 ) ▶₀ #i )
  case initiator_start_case_1
  solve( !Context( $I, s, $I_s, $I_r ) ▶₂ #i )
    case system_init_case_1
    solve( !KU( prot(<n2, $I_s>,
                     g(f(~master_secret, <~n1, n2>), <~n1, n2>, $I_r, 'Key'))
           ) @ #vk.2 )
      case responder_reply_case_2
      solve( !KU( prot(<~n1, $I_s>,
                       g(f(~master_secret, ~n1), ~n1, $I_s, 'Key'))
             ) @ #vk.7 )
        case initiator_start
        solve( !KU( ~n1 ) @ #vk.7 )
          case initiator_start
          solve( !KU( ~n2 ) @ #vk.6 )
            case responder_reply
            SOLVED // trace found
          qed
        qed
      qed
    qed
  qed
qed


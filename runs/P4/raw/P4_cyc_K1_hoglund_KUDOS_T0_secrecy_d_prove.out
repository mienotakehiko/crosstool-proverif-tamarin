    snd(<x.1, x.2>) = x.2





rule (modulo E) system_init:
   [ Fr( ~master_secret ) ]
  -->
   [
   !Context( $A, ~master_secret, $X, $Y ),
   !Context( $B, ~master_secret, $Y, $X )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) initiator_start:
   [ !Context( $I, s, $I_s, $I_r ), Fr( ~n1 ) ]
  -->
   [
   Out( <$I_s, ~n1, prot(<~n1, $I_s>, g(f(s, ~n1), ~n1, $I_s, 'Key'))> ),
   I1( ~n1 )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) responder_reply:
   [
   In( <$R_r, n1, prot(<n1, $R_r>, g(f(s, n1), n1, $R_r, 'Key'))> ),
   !Context( $R, s, $R_s, $R_r ), Fr( ~n2 )
   ]
  --[
  Secret( f(s, <n1, ~n2>) ),
  Secret( g(f(s, <n1, ~n2>), <n1, ~n2>, $R_s, 'Key') ),
  Secret( g(f(s, <n1, ~n2>), <n1, ~n2>, $R_r, 'Key') ),
  Secret( g(f(s, <n1, ~n2>), <n1, ~n2>, 'emptybytestring', 'IV') ),
  Running( $R_s, $R_r,
           <f(s, <n1, ~n2>), g(f(s, <n1, ~n2>), <n1, ~n2>, $R_s, 'Key'), 
            g(f(s, <n1, ~n2>), <n1, ~n2>, $R_r, 'Key'), 
            g(f(s, <n1, ~n2>), <n1, ~n2>, 'emptybytestring', 'IV')>
  )
  ]->
   [
   Out( <~n2, prot(<~n2, $R_r>, g(f(s, <n1, ~n2>), <n1, ~n2>, $R_s, 'Key'))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) initiator_finish:
   [ I1( n1 ), In( <n2, protection> ), !Context( $I, s, $I_s, $I_r ) ]
  --[
  R3( s, $I_s, $I_r, n1, n2 ),
  Eq( check(<n2, $I_s>, protection,
            g(f(s, <n1, n2>), <n1, n2>, $I_r, 'Key')),
      true
  ),
  Secret( f(s, <n1, n2>) ),
  Secret( g(f(s, <n1, n2>), <n1, n2>, $I_s, 'Key') ),
  Secret( g(f(s, <n1, n2>), <n1, n2>, $I_r, 'Key') ),
  Secret( g(f(s, <n1, n2>), <n1, n2>, 'emptybytestring', 'IV') ),
  Commit( $I_s, $I_r,
          <f(s, <n1, n2>), g(f(s, <n1, n2>), <n1, n2>, $I_r, 'Key'), 
           g(f(s, <n1, n2>), <n1, n2>, $I_s, 'Key'), 
           g(f(s, <n1, n2>), <n1, n2>, 'emptybytestring', 'IV')>
  )
  ]->
   [ ]


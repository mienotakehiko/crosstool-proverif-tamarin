guarded formula characterizing all satisfying traces:
"∃ ki kr #i.
  (Detect( <ki, kr> ) @ #i) ∧ ∀ #j. (Compromise( ki ) @ #j) ⇒ ⊥"
*/
by sorry

lemma injectivity [reuse]:
  all-traces
  "∀ id n1 n2 n3 #i #j on1 on2 #k.
    ((((Injectivity( id, n1, n2 ) @ #i) ∧ (Injectivity( id, n2, n3 ) @ #j)) ∧
      (Injectivity( id, on1, on2 ) @ #k)) ∧
     (#k < #j)) ⇒
    (¬(#i < #k))"
/*
guarded formula characterizing all counter-examples:
"∃ id n1 n2 n3 #i #j on1 on2 #k.
  (Injectivity( id, n1, n2 ) @ #i) ∧
  (Injectivity( id, n2, n3 ) @ #j) ∧
  (Injectivity( id, on1, on2 ) @ #k)
 ∧
  (#k < #j) ∧ (#i < #k)"
*/
by sorry

lemma detect_sound:
  all-traces
  "∀ ki kr #t1.
    (Detect( <ki, kr> ) @ #t1) ⇒
    ((∃ #t0. (#t0 < #t1) ∧ (Compromise( ki ) @ #t0)) ∨
     (∃ #t0. (#t0 < #t1) ∧ (Compromise( kr ) @ #t0)))"
/*
guarded formula characterizing all counter-examples:
"∃ ki kr #t1.
  (Detect( <ki, kr> ) @ #t1)
 ∧
  (∀ #t0. (Compromise( ki ) @ #t0) ⇒ ¬(#t0 < #t1)) ∧
  (∀ #t0. (Compromise( kr ) @ #t0) ⇒ ¬(#t0 < #t1))"
*/
simplify
solve( St_I( ~id, ~ltkI.1, pk(x), <'m2', ni.1>, ic ) ▶₀ #t1 )
  case I_m0_case_1
  solve( !KU( sign(<'1', pk(~ltkB), pk(~ltkI.1), ~ni.2, nr.1, src.1>,
                   ~ltkB)
         ) @ #vk.12 )
    case R_m1_case_1
    by contradiction /* from formulas */
  next
    case R_m1_case_2
    solve( !KU( sign(<'2', pk(~ltkI.1), pk(~ltkB), ni.3, nr.3, rc>, ~ltkI.1)
           ) @ #vk.26 )
      case I_detect
      by contradiction /* cyclic */
    next
      case I_m2
      by contradiction /* cyclic */
    next
      case c_sign
      solve( !KU( ~ltkI.1 ) @ #vk.28 )
        case CompromiseKey
        by contradiction /* from formulas */
      qed
    qed
  next
    case c_sign
    solve( !KU( ~ltkB ) @ #vk.14 )
      case CompromiseKey
      by contradiction /* from formulas */
    qed
  qed
next
  case I_m0_case_2
  solve( !KU( sign(<'1', pk(~ltkB), pk(~ltkI.1), ~ni.2, nr.1, src.1>,
                   ~ltkB)
         ) @ #vk.12 )
    case R_m1_case_1
    solve( !KU( sign(<'1', pk(~ltkB), pk(~ltkI.1), ni.3, nr.2, S(ic.1)>,
                     ~ltkB)
           ) @ #vk.25 )
      case R_m1
      by contradiction /* cyclic */
    next
      case c_sign
      solve( !KU( ~ltkB ) @ #vk.28 )
        case CompromiseKey
        by contradiction /* from formulas */
      qed
    qed
  next
    case R_m1_case_2
    solve( !KU( sign(<'1', pk(~ltkB), pk(~ltkI.1), ni.3, nr.2, S(ic.1)>,
                     ~ltkB)
           ) @ #vk.25 )
      case R_m1_case_1
      solve( St_I( ~id, ~ltkI.1, pk(~ltkB), <'m2', ni.3>, '0' ) ▶₀ #vr.1 )
        case I_m0
        solve( !KU( sign(<'2', pk(~ltkI.1), pk(~ltkB), ni.4, nr.4, rc>, ~ltkI.1)
               ) @ #vk.39 )
          case I_detect
          by contradiction /* cyclic */
        next
          case I_m2
          solve( (#vr.18 = #vr.1)  ∥ (#vr.1 < #vr.18) )
            case case_1
            by contradiction /* from formulas */
          next
            case case_2
            by contradiction /* cyclic */
          qed
        next
          case c_sign
          solve( !KU( ~ltkI.1 ) @ #vk.42 )
            case CompromiseKey
            by contradiction /* from formulas */
          qed
        qed
      qed

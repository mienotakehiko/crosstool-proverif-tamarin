  lemmas:
    ∀ id c #i #j.
     (Counter( id, c ) @ #i) ∧ (Counter( id, c ) @ #j) ⇒ #i = #j
    
    ∀ id n1 n2 n3 #i #j on1 on2 #k.
     (Injectivity( id, n1, n2 ) @ #i) ∧
     (Injectivity( id, n2, n3 ) @ #j) ∧
     (Injectivity( id, on1, on2 ) @ #k)
    ⇒
     ((¬(#k < #j)) ∨ (¬(#i < #k)))
    
    ∀ id ni nr #i #j.
     (Nonces( id, ni, nr ) @ #i) ∧ (Gen( ni ) @ #j) ⇒ #j < #i
    
    ∀ id ni nr #i #j.
     (Nonces( id, ni, nr ) @ #i) ∧ (Nonces( id, ni, nr ) @ #j) ⇒ #i = #j
    
    ∀ id1 id2 role ki kr #i #j.
     (Paired( id1, role, ki, kr ) @ #i) ∧
     (Paired( id2, role, ki, kr ) @ #j)
    ⇒
     #i = #j
    
    ∀ role pks ni nr c #i #j.
     (Session( role, pks, <ni, nr>, c ) @ #i) ∧ (Gen( nr ) @ #j)
    ⇒
     #j < #i
    
    ∀ role pks ni nr c #i #j.
     (Session( role, pks, <ni, nr>, c ) @ #i) ∧ (Gen( ni ) @ #j)
    ⇒
     #j < #i
    
    ∀ x y #i. (Eq( x, y ) @ #i) ⇒ x = y
    
    ∀ x y #i. (InEq( x, y ) @ #i) ⇒ ¬(x = y)
  

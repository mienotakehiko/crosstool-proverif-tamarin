  Counter( ~id, src ), Injectivity( ~id, nr, src ),
  Invariant_R( ~id, ~ltkR, pkI )
  ]->
   [ St_R( ~id, ~ltkR, pkI, 'm1', src ) ]

  // loop breaker: [0]

           sign(<'2', pk(~ltkI), pkR, ni, nr, src>, ~ltkI)>
     )
     ]
    variants (modulo AC)
    1. ~ltkI = ~ltkI.3
       ni    = ni.3
       nr    = nr.3
       pkR   = pkR.3
       sig   = sig.3
       src   = src.3
       z     = verify(sig.3, <'1', pkR.3, pk(~ltkI.3), ni.3, nr.3, src.3>,
                      pkR.3)
    
    2. ~ltkI = ~x.6
       ni    = x.8
       nr    = x.9
       pkR   = pk(x.10)
       sig   = sign(<'1', pk(x.10), pk(~x.6), x.8, x.9, x.11>, x.10)
       src   = x.11
       z     = true
  */

rule (modulo E) R_m2:
   [
   St_R( ~id, ~ltkR, pkI, <'m2', ni, nr>, src ), Fr( ~inj ),
   In( <<'2', pkI, pk(~ltkR), ni, nr, src>, sig> )
   ]
  --[
  Eq( verify(sig, <'2', pkI, pk(~ltkR), ni, nr, src>, pkI), true ),

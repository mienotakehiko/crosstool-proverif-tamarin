theory counter_example begin

// Function signature and definition of the equational theory E

functions: S/1, fst/1, h/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true



heuristic: I

/* looping facts with injective instances: St_I/5, St_R/5 */





restriction Eq_testing:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction InEq_testing:
  "∀ x y #i. (InEq( x, y ) @ #i) ⇒ (¬(x = y))"
  // safety formula

restriction pairings_unique:
  "∀ id1 id2 role ki kr #i #j.
    ((Paired( id1, role, ki, kr ) @ #i) ∧
     (Paired( id2, role, ki, kr ) @ #j)) ⇒
    (#i = #j)"
  // safety formula

rule (modulo E) RegisterKey:
   [ Fr( ~ltkA ) ]
  --[ Key( ~ltkA ) ]->
   [ !F_AgentKey( ~ltkA ), Out( pk(~ltkA) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompromiseKey:
   [ !F_AgentKey( ~ltk ) ] --[ Compromise( pk(~ltk) ) ]-> [ Out( ~ltk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BindState_Init:
   [ !F_AgentKey( ~ltkA ), !F_AgentKey( ~ltkB ), Fr( ~id ) ]
  --[
  Paired( ~id, 'I', ~ltkA, ~ltkB ), Counter( ~id, '0' ),
  F_InvariantSource_I( ~id, ~ltkA, pk(~ltkB) )
  ]->
   [ St_I( ~id, ~ltkA, pk(~ltkB), 'm0', '0' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) BindState_Resp:
   [ !F_AgentKey( ~ltkA ), !F_AgentKey( ~ltkB ), Fr( ~id ) ]
  --[
  Paired( ~id, 'R', ~ltkA, ~ltkB ), Counter( ~id, '0' ),
  F_InvariantSource_R( ~id, ~ltkA, pk(~ltkB) )
  ]->
   [ St_R( ~id, ~ltkA, pk(~ltkB), 'm1', '0' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) I_m0:
   [ St_I( ~id, ~ltkI, pkR, 'm0', ic ), Fr( ~ni ) ]
  --[
  Begin( 'I', <pk(~ltkI), pkR>, S(ic) ), Counter( <~id, 'm0'>, ic ),
  Gen( ~ni ), Injectivity( ~id, ic, ~ni ), Invariant_I( ~id, ~ltkI, pkR )
  ]->
   [ St_I( ~id, ~ltkI, pkR, <'m2', ~ni>, ic ), Out( ~ni ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) R_m1:
   [ St_R( ~id, ~ltkR, pkI, 'm1', rc ), Fr( ~nr ), In( ni ) ]
  --[
  Begin( 'R', <pkI, pk(~ltkR)>, S(rc) ), Counter( <~id, 'm1'>, rc ),
  Nonces( ~id, ni, ~nr ), Gen( ~nr ), Injectivity( ~id, rc, ~nr ),
  Invariant_R( ~id, ~ltkR, pkI )
  ]->
   [
   St_R( ~id, ~ltkR, pkI, <'m2', ni, ~nr>, S(rc) ),
   Out( <<'1', pk(~ltkR), pkI, ni, ~nr, S(rc)>, 
         sign(<'1', pk(~ltkR), pkI, ni, ~nr, S(rc)>, ~ltkR)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) I_m2:
   [
   St_I( ~id, ~ltkI, pkR, <'m2', ni>, ic ),
   In( <<'1', pkR, pk(~ltkI), ni, nr, src>, sig> )
   ]
  --[
  Eq( verify(sig, <'1', pkR, pk(~ltkI), ni, nr, src>, pkR), true ),
  Eq( S(ic), src ), Counter( ~id, S(ic) ), Nonces( ~id, ni, nr ),
  Session( 'I', <pk(~ltkI), pkR>, <ni, nr>, src ),
  Injectivity( ~id, ni, S(ic) ), Invariant_I( ~id, ~ltkI, pkR )
  ]->
   [
   St_I( ~id, ~ltkI, pkR, 'm0', S(ic) ),
   Out( <<'2', pk(~ltkI), pkR, ni, nr, src>, 
         sign(<'2', pk(~ltkI), pkR, ni, nr, src>, ~ltkI)>
   )
   ]

  // loop breaker: [0]
  /*
  rule (modulo AC) I_m2:
     [
     St_I( ~id, ~ltkI, pkR, <'m2', ni>, ic ),
     In( <<'1', pkR, pk(~ltkI), ni, nr, src>, sig> )
     ]
    --[
    Eq( z, true ), Eq( S(ic), src ), Counter( ~id, S(ic) ),
    Nonces( ~id, ni, nr ), Session( 'I', <pk(~ltkI), pkR>, <ni, nr>, src ),
    Injectivity( ~id, ni, S(ic) ), Invariant_I( ~id, ~ltkI, pkR )
    ]->
     [
     St_I( ~id, ~ltkI, pkR, 'm0', S(ic) ),
     Out( <<'2', pk(~ltkI), pkR, ni, nr, src>, 
           sign(<'2', pk(~ltkI), pkR, ni, nr, src>, ~ltkI)>
     )
     ]
    variants (modulo AC)
    1. ~ltkI = ~ltkI.3
       ni    = ni.3
       nr    = nr.3
       pkR   = pkR.3
       sig   = sig.3
       src   = src.3
       z     = verify(sig.3, <'1', pkR.3, pk(~ltkI.3), ni.3, nr.3, src.3>,
                      pkR.3)
    
    2. ~ltkI = ~x.6
       ni    = x.8
       nr    = x.9
       pkR   = pk(x.10)
       sig   = sign(<'1', pk(x.10), pk(~x.6), x.8, x.9, x.11>, x.10)
       src   = x.11
       z     = true
    // loop breaker: [0]
  */

rule (modulo E) I_detect:
   [
   St_I( ~id, ~ltkI, pkR, <'m2', ni>, ic ),
   In( <<'1', pkR, pk(~ltkI), ni, nr, src>, sig> )
   ]
  --[
  Eq( verify(sig, <'1', pkR, pk(~ltkI), ni, nr, src>, pkR), true ),
  InEq( S(ic), src ), Detect( <pk(~ltkI), pkR> ), Counter( ~id, S(ic) ),
  Nonces( ~id, ni, nr ), Session( 'I', <pk(~ltkI), pkR>, <ni, nr>, src ),
  Injectivity( ~id, ni, S(ic) ), Invariant_I( ~id, ~ltkI, pkR )
  ]->
   [
   Remediate_Compromise( ~id, ~ltkI, pkR, 'm0', S(ic) ),
   Out( <<'2', pk(~ltkI), pkR, ni, nr, src>, 
         sign(<'2', pk(~ltkI), pkR, ni, nr, src>, ~ltkI)>
   )
   ]

  /*

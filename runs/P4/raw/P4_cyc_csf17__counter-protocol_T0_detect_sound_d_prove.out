lemma invariant_sources [sources]:
  all-traces
  "(∀ id ka kb #i.
     (Invariant_I( id, ka, kb ) @ #i) ⇒
     (∃ #j. (F_InvariantSource_I( id, ka, kb ) @ #j) ∧ (#j < #i))) ∧
   (∀ id ka kb #i.
     (Invariant_R( id, ka, kb ) @ #i) ⇒
     (∃ #j. (F_InvariantSource_R( id, ka, kb ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"((∃ id ka kb #i.
    (Invariant_I( id, ka, kb ) @ #i)
   ∧
    ∀ #j. (F_InvariantSource_I( id, ka, kb ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ id ka kb #i.
    (Invariant_R( id, ka, kb ) @ #i)
   ∧
    ∀ #j. (F_InvariantSource_R( id, ka, kb ) @ #j) ⇒ ¬(#j < #i)))"
*/
by sorry

lemma count_unique [reuse, use_induction]:
  all-traces
  "∀ id c #i #j.
    ((Counter( id, c ) @ #i) ∧ (Counter( id, c ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ id c #i #j.
  (Counter( id, c ) @ #i) ∧ (Counter( id, c ) @ #j) ∧ ¬(#i = #j)"
*/
by sorry

lemma nonces_unique [reuse, use_induction]:
  all-traces
  "∀ id ni nr #i #j.
    ((Nonces( id, ni, nr ) @ #i) ∧ (Nonces( id, ni, nr ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ id ni nr #i #j.
  (Nonces( id, ni, nr ) @ #i) ∧ (Nonces( id, ni, nr ) @ #j) ∧ ¬(#i = #j)"
*/
by sorry

lemma force_nonce_ordering [reuse]:
  all-traces
  "((∀ role pks ni nr c #i #j.
      ((Session( role, pks, <ni, nr>, c ) @ #i) ∧ (Gen( ni ) @ #j)) ⇒
      (#j < #i)) ∧
    (∀ role pks ni nr c #i #j.
      ((Session( role, pks, <ni, nr>, c ) @ #i) ∧ (Gen( nr ) @ #j)) ⇒
      (#j < #i))) ∧
   (∀ id ni nr #i #j.
     ((Nonces( id, ni, nr ) @ #i) ∧ (Gen( ni ) @ #j)) ⇒ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"((∃ role pks ni nr c #i #j.
    (Session( role, pks, <ni, nr>, c ) @ #i) ∧ (Gen( ni ) @ #j)
   ∧
    ¬(#j < #i)) ∨
  (∃ role pks ni nr c #i #j.
    (Session( role, pks, <ni, nr>, c ) @ #i) ∧ (Gen( nr ) @ #j)
   ∧
    ¬(#j < #i)) ∨
  (∃ id ni nr #i #j.
    (Nonces( id, ni, nr ) @ #i) ∧ (Gen( ni ) @ #j) ∧ ¬(#j < #i)))"
*/
by sorry

lemma exists_session:
  exists-trace
  "∃ pks nonces c #t0 #t1.
    ((((#t0 < #t1) ∧ (Session( 'I', pks, nonces, c ) @ #t0)) ∧
      (Session( 'R', pks, nonces, c ) @ #t1)) ∧
     (¬(∃ #k key. Compromise( key ) @ #k))) ∧
    (¬(∃ #k. Detect( pks ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ pks nonces c #t0 #t1.
  (Session( 'I', pks, nonces, c ) @ #t0) ∧
  (Session( 'R', pks, nonces, c ) @ #t1)
 ∧
  (#t0 < #t1) ∧
  (∀ #k key. (Compromise( key ) @ #k) ⇒ ⊥) ∧
  (∀ #k. (Detect( pks ) @ #k) ⇒ ⊥)"
*/
by sorry

lemma exists_second_session:
  exists-trace
  "∃ pks nonces nonces2 c #t0 #t1 #t2 #t3.
    ((((((((#t0 < #t2) ∧ (#t1 < #t3)) ∧ (c = S('0'))) ∧
         (Session( 'I', pks, nonces, c ) @ #t0)) ∧
        (Session( 'R', pks, nonces, c ) @ #t1)) ∧
       (Session( 'I', pks, nonces2, S(c) ) @ #t2)) ∧
      (Session( 'R', pks, nonces2, S(c) ) @ #t3)) ∧
     (¬(∃ #k key. Compromise( key ) @ #k))) ∧
    (¬(∃ #k. Detect( pks ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ pks nonces nonces2 c #t0 #t1 #t2 #t3.
  (c = S('0')) ∧
  (Session( 'I', pks, nonces, c ) @ #t0) ∧
  (Session( 'R', pks, nonces, c ) @ #t1) ∧
  (Session( 'I', pks, nonces2, S(c) ) @ #t2) ∧
  (Session( 'R', pks, nonces2, S(c) ) @ #t3)
 ∧
  (#t0 < #t2) ∧
  (#t1 < #t3) ∧
  (∀ #k key. (Compromise( key ) @ #k) ⇒ ⊥) ∧
  (∀ #k. (Detect( pks ) @ #k) ⇒ ⊥)"
*/
by sorry

lemma exists_detect_no_R_compromise:
  exists-trace
  "∃ ki kr #i.
    (Detect( <ki, kr> ) @ #i) ∧ (¬(∃ #j. Compromise( kr ) @ #j))"
/*
guarded formula characterizing all satisfying traces:
"∃ ki kr #i.
  (Detect( <ki, kr> ) @ #i) ∧ ∀ #j. (Compromise( kr ) @ #j) ⇒ ⊥"
*/

lemma exists_session:
  exists-trace
  "∃ pks nonces c #t0 #t1.
    ((((#t0 < #t1) ∧ (Session( 'I', pks, nonces, c ) @ #t0)) ∧
      (Session( 'R', pks, nonces, c ) @ #t1)) ∧
     (¬(∃ #k key. Compromise( key ) @ #k))) ∧
    (¬(∃ #k. Detect( pks ) @ #k))"
/*
guarded formula characterizing all satisfying traces:
"∃ pks nonces c #t0 #t1.
  (Session( 'I', pks, nonces, c ) @ #t0) ∧
  (Session( 'R', pks, nonces, c ) @ #t1)
 ∧
  (#t0 < #t1) ∧
  (∀ #k key. (Compromise( key ) @ #k) ⇒ ⊥) ∧
  (∀ #k. (Detect( pks ) @ #k) ⇒ ⊥)"
*/
by sorry


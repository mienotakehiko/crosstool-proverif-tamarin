lemma invariant_sources [sources]:
  all-traces
  "(∀ id ka kb #i.
     (Invariant_I( id, ka, kb ) @ #i) ⇒
     (∃ #j. (F_InvariantSource_I( id, ka, kb ) @ #j) ∧ (#j < #i))) ∧
   (∀ id ka kb #i.
     (Invariant_R( id, ka, kb ) @ #i) ⇒
     (∃ #j. (F_InvariantSource_R( id, ka, kb ) @ #j) ∧ (#j < #i)))"
/*
guarded formula characterizing all counter-examples:
"((∃ id ka kb #i.
    (Invariant_I( id, ka, kb ) @ #i)
   ∧
    ∀ #j. (F_InvariantSource_I( id, ka, kb ) @ #j) ⇒ ¬(#j < #i)) ∨
  (∃ id ka kb #i.
    (Invariant_R( id, ka, kb ) @ #i)
   ∧
    ∀ #j. (F_InvariantSource_R( id, ka, kb ) @ #j) ⇒ ¬(#j < #i)))"
*/
by sorry


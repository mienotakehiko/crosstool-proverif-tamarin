lemma unmatching_implies_detect_with_R_uncompromised [use_induction]:
  all-traces
  "∀ keys nonces1 nonces2 c1 c2 #t1 #t2 #t3.
    (((((#t1 < #t3) ∧ (Begin( 'R', keys, c2 ) @ #t3)) ∧
       (Session( 'I', keys, nonces2, c2 ) @ #t2)) ∧
      (¬(Detect( keys ) @ #t2))) ∧
     (Session( 'R', keys, nonces1, c1 ) @ #t1)) ⇒
    ((∃ #t0. Session( 'I', keys, nonces1, c1 ) @ #t0) ∨
     (∃ i r #tc. (keys = <i, r>) ∧ (Compromise( i ) @ #tc)))"
/*
guarded formula characterizing all counter-examples:
"∃ keys nonces1 nonces2 c1 c2 #t1 #t2 #t3.
  (Begin( 'R', keys, c2 ) @ #t3) ∧
  (Session( 'I', keys, nonces2, c2 ) @ #t2) ∧
  (Session( 'R', keys, nonces1, c1 ) @ #t1)
 ∧
  (#t1 < #t3) ∧
  (¬(Detect( keys ) @ #t2)) ∧
  (∀ #t0. (Session( 'I', keys, nonces1, c1 ) @ #t0) ⇒ ⊥) ∧
  (∀ i r #tc. (keys = <i, r>) ∧ (Compromise( i ) @ #tc) ⇒ ⊥)"
*/
induction
  case empty_trace
  by contradiction /* from formulas */
next
  case non_empty_trace
  solve( Begin( 'R', keys, c2 ) @ #t3 )
    case R_m1
    solve( Session( 'I', <pkI, pk(~ltkR)>, nonces2, S(rc) ) @ #t2 )
      case I_detect
      by contradiction /* from formulas */
    next
      case I_m2
      solve( Session( 'R', <pk(~ltkI), pk(~ltkR)>, nonces1, c1 ) @ #t1 )
        case R_m2
        solve( St_R( ~id.2, ~ltkR, pk(~ltkI), 'm1', ic ) ▶₀ #t3 )
          case BindState_Resp
          solve( (last(#t3))  ∥ (last(#t2))  ∥
                 (∃ #t0.
                   (Session( 'I', <pk(~ltkI), pk(~ltkR)>, <ni, nr>, c1 ) @ #t0)
                  ∧
                   ¬(last(#t0)))  ∥
                 (∃ i r #tc.
                   (<pk(~ltkI), pk(~ltkR)> = <i, r>) ∧ (Compromise( i ) @ #tc)
                  ∧
                   ¬(last(#tc))) )
            case case_1
            solve( St_I( ~id.1, ~ltkI, pk(~ltkR), <'m2', ni.1>, '0' ) ▶₀ #t2 )
              case I_m0
              solve( !KU( sign(<'1', pk(~ltkR), pk(~ltkI), ~ni.1, nr.1, S('0')>, ~ltkR)
                     ) @ #vk.17 )
                case R_m1
                by contradiction /* node #t2 after last node #t3 */
              next
                case c_sign
                solve( !KU( ~ltkR ) @ #vk.25 )
                  case CompromiseKey
                  solve( St_R( ~id, ~ltkR, pk(~ltkI), <'m2', ni, nr>, c1 ) ▶₀ #t1 )
                    case R_m1_case_1
                    by contradiction /* cyclic */
                  next
                    case R_m1_case_2
                    by contradiction /* cyclic */
                  qed
                qed
              qed
            qed
          next
            case case_2
            solve( St_I( ~id.1, ~ltkI, pk(~ltkR), <'m2', ni.1>, '0' ) ▶₀ #t2 )
              case I_m0
              solve( !KU( sign(<'1', pk(~ltkR), pk(~ltkI), ~ni.1, nr.1, S('0')>, ~ltkR)
                     ) @ #vk.17 )
                case R_m1
                solve( St_R( ~id, ~ltkR, pk(~ltkI), <'m2', ni, nr>, c1 ) ▶₀ #t1 )
                  case R_m1_case_1
                  by contradiction /* cyclic */
                next
                  case R_m1_case_2
                  by contradiction /* cyclic */
                qed

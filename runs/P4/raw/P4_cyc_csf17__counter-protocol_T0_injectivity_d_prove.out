lemma detect_sound:
  all-traces
  "∀ ki kr #t1.
    (Detect( <ki, kr> ) @ #t1) ⇒
    ((∃ #t0. (#t0 < #t1) ∧ (Compromise( ki ) @ #t0)) ∨
     (∃ #t0. (#t0 < #t1) ∧ (Compromise( kr ) @ #t0)))"
/*
guarded formula characterizing all counter-examples:
"∃ ki kr #t1.
  (Detect( <ki, kr> ) @ #t1)
 ∧
  (∀ #t0. (Compromise( ki ) @ #t0) ⇒ ¬(#t0 < #t1)) ∧
  (∀ #t0. (Compromise( kr ) @ #t0) ⇒ ¬(#t0 < #t1))"
*/
by sorry

lemma correct_dolevyao:
  all-traces
  "∀ pks nonces c #t1.
    ((Session( 'R', pks, nonces, c ) @ #t1) ∧
     (¬(∃ k #tc. Compromise( k ) @ #tc))) ⇒
    (∃ #t0. (#t0 < #t1) ∧ (Session( 'I', pks, nonces, c ) @ #t0))"

(* Events *)
event eAcceptTop(bitstring, bitstring, bitstring).
event eDg(bitstring, bitstring, bitstring, bitstring).
event eDistinctFact(bitstring, bitstring).
event eHssAccept(bitstring, bitstring, bitstring).
event eKeyGen(bitstring).
event eRevealBot(bitstring, bitstring).
event eRevealTop(bitstring).
event eSignBot(bitstring, bitstring, bitstring).
event eSignTop(bitstring, bitstring).

(* Tables *)
table tBotSt(bitstring, bitstring, bitstring, bitstring, bitstring).
table tRoot(bitstring, bitstring).
table tSkB(bitstring, bitstring, bitstring).
table tSkT(bitstring, bitstring).
table tTopOK(bitstring, bitstring, bitstring).
table tTopPending(bitstring, bitstring, bitstring, bitstring, bitstring).

(* Restrictions *)

(* DgFun *)

restriction X:bitstring, a:bitstring, b:bitstring, m:bitstring,
            q:bitstring, i:time, j:time;
  event(eDg( X, q, m, a ))@i && event(eDg( X, q, m, b ))@j ==> a = b.

(* DistinctFact *)

restriction rid_i:bitstring, rid_j:bitstring, x:bitstring, i:time,
            j:time;
  event(eDistinctFact( rid_i, x ))@i && event(eDistinctFact( rid_j, x ))@j
  ==> rid_i = rid_j.

(* Queries *)

(* LS7 *)

query I:bitstring, J:bitstring, m:bitstring, k:time, r:time, s:time,
      t:time;
  event(eHssAccept( I, J, m ))@k
  ==> (event(eSignTop( I, J ))@s && event(eSignBot( I, J, m ))@t)
      || event(eRevealTop( I ))@r
      || (event(eSignTop( I, J ))@s && event(eRevealBot( I, J ))@r).

(* Processes *)

let rKeyGen =
        new stR_TopPending: bitstring;
        new I: bitstring;
        new sdT: bitstring;
        new J: bitstring;
        new sdB: bitstring;
        event eKeyGen(I);
        insert tSkT(I, sdT);
        insert tSkB(I, J, sdB);
        insert tTopPending(stR_TopPending, I, sdT, J, sdB);
        insert tRoot(I,
                     hl(I, (ch(I, vm, ch(I, vm, ch(I, vm, prf(sdT, z(), vm)))), ch(I, vk, ch(I, vk, ch(I, vk, prf(sdT, z(), vk))))), (ch(I, vm, ch(I, vm, ch(I, vm, prf(sdT, s(z()), vm)))), ch(I, vk, ch(I, vk, ch(I, vk, prf(sdT, s(z()), vk)))))));
        out(publicChannel, (I, hl(I, (ch(I, vm, ch(I, vm, ch(I, vm, prf(sdT, z(), vm)))), ch(I, vk, ch(I, vk, ch(I, vk, prf(sdT, z(), vk))))), (ch(I, vm, ch(I, vm, ch(I, vm, prf(sdT, s(z()), vm)))), ch(I, vk, ch(I, vk, ch(I, vk, prf(sdT, s(z()), vk)))))))).


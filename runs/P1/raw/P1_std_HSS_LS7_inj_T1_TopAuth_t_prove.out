                case TopSign_a1
                solve( !KU( ch(~I, 'k', ch(~I, 'k', prf(~sdT, s(z), 'k'))) ) @ #vk.25 )
                  case c_ch
                  solve( !KU( ch(~I, 'k', prf(~sdT, s(z), 'k')) ) @ #vk.26 )
                    case c_ch
                    by solve( !KU( prf(~sdT, z, 'm') ) @ #vk.22 )
                  qed
                qed
              next

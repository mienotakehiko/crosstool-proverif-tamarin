theory HSS_LS7_inj

begin

// Function signature and definition of the equational theory E

functions: ch/3, fst/1, hl/3, pair/2, prf/3[private,constructor], s/1,
           snd/1, z/0
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

tactic: statefirst
presort: C
prio: {id}
  regex"St\(" | regex"Snap\(" | regex"BotSt\(" | regex"TopPending\("
prio: {id}
  regex"!Root\(" | regex"!TopOK\("
prio: {id}
  regex"Misuse\(" | regex"Clone\(" | regex"Rollback\("
deprio: {id}
  regex"KU\(*ch\(" | regex"KU\(*hl\("
deprio: {id}
  regex"KU\(*prf\("

restriction DgFun:
  "∀ X q m a b #i #j.
    ((Dg( X, q, m, a ) @ #i) ∧ (Dg( X, q, m, b ) @ #j)) ⇒ (a = b)"
  // safety formula

  /*
  expanded formula:
  "∀ X q m a b #i #j.
    ((Dg( X, q, m, a ) @ #i) ∧ (Dg( X, q, m, b ) @ #j)) ⇒ (a = b)"
  */

restriction DgInj:
  "∀ X q m1 m2 a #i #j.
    ((Dg( X, q, m1, a ) @ #i) ∧ (Dg( X, q, m2, a ) @ #j)) ⇒ (m1 = m2)"
  // safety formula

  /*
  expanded formula:
  "∀ X q m1 m2 a #i #j.
    ((Dg( X, q, m1, a ) @ #i) ∧ (Dg( X, q, m2, a ) @ #j)) ⇒ (m1 = m2)"
  */

rule (modulo E) KeyGen:
   [ Fr( ~I ), Fr( ~sdT ), Fr( ~J ), Fr( ~sdB ) ]
  --[ KeyGen( ~I ) ]->
   [
   !SkT( ~I, ~sdT ), !SkB( ~I, ~J, ~sdB ), TopPending( ~I, ~sdT, ~J, ~sdB ),
   !Root( ~I,
          hl(~I,
             <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sdT, z, 'm')))), 
              ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sdT, z, 'k'))))>,
             <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sdT, s(z), 'm')))), 
              ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sdT, s(z), 'k'))))>)
   ),
   Out( <~I, 
         hl(~I,
            <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sdT, z, 'm')))), 
             ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sdT, z, 'k'))))>,
            <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sdT, s(z), 'm')))), 
             ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sdT, s(z), 'k'))))>)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) TopSign_a0:
   [ TopPending( I, sdT, J, sdB ), In( <'top', z> ) ]
  --[
  Dg( I, z,
      <J, 
       hl(J,
          <ch(J, 'm', ch(J, 'm', ch(J, 'm', prf(sdB, z, 'm')))), 
           ch(J, 'k', ch(J, 'k', ch(J, 'k', prf(sdB, z, 'k'))))>,
          <ch(J, 'm', ch(J, 'm', ch(J, 'm', prf(sdB, s(z), 'm')))), 
           ch(J, 'k', ch(J, 'k', ch(J, 'k', prf(sdB, s(z), 'k'))))>)
      >,
      z
  ),
  SignTop( I, J )
  ]->
   [
   BotSt( I, J, sdB, z ),
   Out( <I, J, 
         hl(J,
            <ch(J, 'm', ch(J, 'm', ch(J, 'm', prf(sdB, z, 'm')))), 
             ch(J, 'k', ch(J, 'k', ch(J, 'k', prf(sdB, z, 'k'))))>,
            <ch(J, 'm', ch(J, 'm', ch(J, 'm', prf(sdB, s(z), 'm')))), 
             ch(J, 'k', ch(J, 'k', ch(J, 'k', prf(sdB, s(z), 'k'))))>), 
         z, z, prf(sdT, z, 'm'), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sdT, z, 'k')))), 
         ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sdT, s(z), 'm')))), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sdT, s(z), 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) TopSign_a1:
   [ TopPending( I, sdT, J, sdB ), In( <'top', s(z)> ) ]
  --[

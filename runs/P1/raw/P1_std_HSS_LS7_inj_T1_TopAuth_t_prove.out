rule (modulo E) VerTop_q1_a3:
   [
   !Root( I, hl(I, sib, <sm, ch(I, 'k', ch(I, 'k', ch(I, 'k', sk)))>) ),
   In( <I, J, rB, s(z), s(s(s(z))), sm, sk, sib> )
   ]
  --[ Dg( I, s(z), <J, rB>, s(s(s(z))) ), AcceptTop( I, J, rB ) ]->
   [ !TopOK( I, J, rB ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) VerBot_q0_a0:
   [
   !TopOK( I, J, hl(J, <ch(J, 'm', ch(J, 'm', ch(J, 'm', sm))), sk>, sib) ),
   In( <I, J, m, z, z, sm, sk, sib> )
   ]
  --[ Dg( J, z, m, z ), HssAccept( I, J, m ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) VerBot_q0_a1:
   [
   !TopOK( I, J, hl(J, <ch(J, 'm', ch(J, 'm', sm)), ch(J, 'k', sk)>, sib) ),
   In( <I, J, m, z, s(z), sm, sk, sib> )
   ]
  --[ Dg( J, z, m, s(z) ), HssAccept( I, J, m ) ]->
   [ ]

  /* has exactly the trivial AC variant */


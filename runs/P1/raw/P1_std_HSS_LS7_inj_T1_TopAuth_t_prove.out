lemma exec:
  exists-trace
  "∃ I J m #k.
    ((HssAccept( I, J, m ) @ #k) ∧ (¬(∃ #r. RevealTop( I ) @ #r))) ∧
    (¬(∃ #r. RevealBot( I, J ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ I J m #k.
  (HssAccept( I, J, m ) @ #k)
 ∧
  (∀ #r. (RevealTop( I ) @ #r) ⇒ ⊥) ∧ (∀ #r. (RevealBot( I, J ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma TopAuth [reuse]:
  all-traces
  "∀ I J rB #k.
    (AcceptTop( I, J, rB ) @ #k) ⇒
    ((∃ #s. SignTop( I, J ) @ #s) ∨ (∃ #r. RevealTop( I ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ I J rB #k.
  (AcceptTop( I, J, rB ) @ #k)
 ∧
  (∀ #s. (SignTop( I, J ) @ #s) ⇒ ⊥) ∧ (∀ #r. (RevealTop( I ) @ #r) ⇒ ⊥)"
*/
simplify
solve( AcceptTop( I, J, rB ) @ #k )
  case VerTop_q0_a0
  solve( !Root( I, hl(I, <ch(I, 'm', ch(I, 'm', ch(I, 'm', sm))), sk>, sib)
         ) ▶₀ #k )
    case KeyGen
    solve( !KU( ~I ) @ #vk.1 )
      case BotSign_q0_a0_case_1
      by contradiction /* from formulas */
    next
      case BotSign_q0_a0_case_2
      solve( !KU( s(z) ) @ #vk.22 )
        case c_s
        solve( !KU( ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sdT, z, 'k'))))
               ) @ #vk.15 )
          case c_ch
          solve( !KU( ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sdT, s(z), 'm'))))
                 ) @ #vk.18 )
            case TopSign_a1
            solve( !KU( ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sdT, s(z), 'k'))))
                   ) @ #vk.19 )
              case TopSign_a1
              solve( !KU( ch(~I, 'k', ch(~I, 'k', prf(~sdT, z, 'k'))) ) @ #vk.24 )
                case TopSign_a1
                by solve( !KU( prf(~sdT, z, 'm') ) @ #vk.20 )
              next
                case c_ch
                solve( !KU( ch(~I, 'k', prf(~sdT, z, 'k')) ) @ #vk.25 )
                  case c_ch
                  by solve( !KU( prf(~sdT, z, 'm') ) @ #vk.21 )
                qed
              qed
            next

lemma exec:
  exists-trace
  "∃ I q a #s #k.
    ((Sign( I, q, a ) @ #s) ∧ (Accept( I, q, a ) @ #k)) ∧
    (¬(∃ #r. RevealSeed( I ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ I q a #s #k.
  (Sign( I, q, a ) @ #s) ∧ (Accept( I, q, a ) @ #k)
 ∧
  ∀ #r. (RevealSeed( I ) @ #r) ⇒ ⊥"
*/
by sorry

lemma LS1:
  all-traces
  "∀ I q a #k.
    (Accept( I, q, a ) @ #k) ⇒
    ((∃ #s. Sign( I, q, a ) @ #s) ∨ (∃ #r. RevealSeed( I ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ I q a #k.
  (Accept( I, q, a ) @ #k)
 ∧
  (∀ #s. (Sign( I, q, a ) @ #s) ⇒ ⊥) ∧ (∀ #r. (RevealSeed( I ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma LS6_bind:
  all-traces
  "∀ I q a #k.
    (Accept( I, q, a ) @ #k) ⇒
    ((∃ b #s. Sign( I, q, b ) @ #s) ∨ (∃ #r. RevealSeed( I ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ I q a #k.
  (Accept( I, q, a ) @ #k)
 ∧
  (∀ b #s. (Sign( I, q, b ) @ #s) ⇒ ⊥) ∧
  (∀ #r. (RevealSeed( I ) @ #r) ⇒ ⊥)"
*/
by sorry


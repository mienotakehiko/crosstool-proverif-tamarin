theory LMS_S2_rollback

begin

// Function signature and definition of the equational theory E

functions: ch/3, fst/1, hl/3, pair/2, prf/3[private,constructor], s/1,
           snd/1, z/0
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

tactic: statefirst
presort: C
prio: {id}
  regex"St\(" | regex"Snap\(" | regex"BotSt\(" | regex"TopPending\("
prio: {id}
  regex"!Root\(" | regex"!TopOK\("
prio: {id}
  regex"Misuse\(" | regex"Clone\(" | regex"Rollback\("
deprio: {id}
  regex"KU\(*ch\(" | regex"KU\(*hl\("
deprio: {id}
  regex"KU\(*prf\("

/* looping facts with injective instances: St/2 */

restriction Cks:
  "∀ a c #i.
    (Cks( a, c ) @ #i) ⇒
    (((((a = z) ∧ (c = s(s(s(z))))) ∨ ((a = s(z)) ∧ (c = s(s(z))))) ∨
      ((a = s(s(z))) ∧ (c = s(z)))) ∨
     ((a = s(s(s(z)))) ∧ (c = z)))"
  // safety formula

  /*
  expanded formula:
  "∀ a c #i.
    (Cks( a, c ) @ #i) ⇒
    (((((a = z) ∧ (c = s(s(s(z))))) ∨ ((a = s(z)) ∧ (c = s(s(z))))) ∨
      ((a = s(s(z))) ∧ (c = s(z)))) ∨
     ((a = s(s(s(z)))) ∧ (c = z)))"
  */

rule (modulo E) KeyGen:
   [ Fr( ~I ), Fr( ~sd ) ]
  --[ KeyGen( ~I ) ]->
   [
   !Sk( ~I, ~sd ), St( ~I, z ), !Snap( ~I, z ),
   !Root( ~I,
          hl(~I,
             <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, z, 'm')))), 
              ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, z, 'k'))))>,
             <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(z), 'm')))), 
              ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(z), 'k'))))>)
   ),
   Out( <~I, 
         hl(~I,
            <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, z, 'm')))), 
             ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, z, 'k'))))>,
            <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(z), 'm')))), 
             ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(z), 'k'))))>)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q0_a0:
   [ St( I, z ), !Sk( I, sd ), In( <'sign', z> ) ]
  --[ Cks( z, s(s(s(z))) ), Sign( I, z, z ), UseLeaf( I, z ) ]->
   [
   St( I, s(z) ), !Snap( I, s(z) ),
   Out( <I, z, z, prf(sd, z, 'm'), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, z, 'k')))), 
         ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sd, s(z), 'm')))), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, s(z), 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q0_a1:
   [ St( I, z ), !Sk( I, sd ), In( <'sign', s(z)> ) ]
  --[ Cks( s(z), s(s(z)) ), Sign( I, z, s(z) ), UseLeaf( I, z ) ]->
   [
   St( I, s(z) ), !Snap( I, s(z) ),
   Out( <I, z, s(z), ch(I, 'm', prf(sd, z, 'm')), 
         ch(I, 'k', ch(I, 'k', prf(sd, z, 'k'))), 
         ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sd, s(z), 'm')))), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, s(z), 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q0_a2:
   [ St( I, z ), !Sk( I, sd ), In( <'sign', s(s(z))> ) ]
  --[ Cks( s(s(z)), s(z) ), Sign( I, z, s(s(z)) ), UseLeaf( I, z ) ]->
   [
   St( I, s(z) ), !Snap( I, s(z) ),
   Out( <I, z, s(s(z)), ch(I, 'm', ch(I, 'm', prf(sd, z, 'm'))), 
         ch(I, 'k', prf(sd, z, 'k')), 
         ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sd, s(z), 'm')))), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, s(z), 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q0_a3:
   [ St( I, z ), !Sk( I, sd ), In( <'sign', s(s(s(z)))> ) ]
  --[ Cks( s(s(s(z))), z ), Sign( I, z, s(s(s(z))) ), UseLeaf( I, z ) ]->
   [
   St( I, s(z) ), !Snap( I, s(z) ),
   Out( <I, z, s(s(s(z))), 
         ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sd, z, 'm')))), prf(sd, z, 'k'), 
         ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sd, s(z), 'm')))), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, s(z), 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q1_a0:
   [ St( I, s(z) ), !Sk( I, sd ), In( <'sign', z> ) ]
  --[ Cks( z, s(s(s(z))) ), Sign( I, s(z), z ), UseLeaf( I, s(z) ) ]->
   [
   St( I, s(s(z)) ), !Snap( I, s(s(z)) ),
   Out( <I, s(z), z, prf(sd, s(z), 'm'), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, s(z), 'k')))), 
         ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sd, z, 'm')))), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, z, 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q1_a1:
   [ St( I, s(z) ), !Sk( I, sd ), In( <'sign', s(z)> ) ]
  --[ Cks( s(z), s(s(z)) ), Sign( I, s(z), s(z) ), UseLeaf( I, s(z) ) ]->
   [
   St( I, s(s(z)) ), !Snap( I, s(s(z)) ),
   Out( <I, s(z), s(z), ch(I, 'm', prf(sd, s(z), 'm')), 
         ch(I, 'k', ch(I, 'k', prf(sd, s(z), 'k'))), 
         ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sd, z, 'm')))), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, z, 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q1_a2:
   [ St( I, s(z) ), !Sk( I, sd ), In( <'sign', s(s(z))> ) ]
  --[ Cks( s(s(z)), s(z) ), Sign( I, s(z), s(s(z)) ), UseLeaf( I, s(z) )
  ]->
   [
   St( I, s(s(z)) ), !Snap( I, s(s(z)) ),
   Out( <I, s(z), s(s(z)), ch(I, 'm', ch(I, 'm', prf(sd, s(z), 'm'))), 
         ch(I, 'k', prf(sd, s(z), 'k')), 
         ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sd, z, 'm')))), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, z, 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q1_a3:
   [ St( I, s(z) ), !Sk( I, sd ), In( <'sign', s(s(s(z)))> ) ]
  --[ Cks( s(s(s(z))), z ), Sign( I, s(z), s(s(s(z))) ), UseLeaf( I, s(z) )
  ]->
   [
   St( I, s(s(z)) ), !Snap( I, s(s(z)) ),
   Out( <I, s(z), s(s(s(z))), 
         ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sd, s(z), 'm')))), 
         prf(sd, s(z), 'k'), ch(I, 'm', ch(I, 'm', ch(I, 'm', prf(sd, z, 'm')))), 
         ch(I, 'k', ch(I, 'k', ch(I, 'k', prf(sd, z, 'k'))))>
   )
   ]

  /* has exactly the trivial AC variant */

restriction OneMisuse:
  "∀ I #i #j. ((Misuse( I ) @ #i) ∧ (Misuse( I ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ I #i #j. ((Misuse( I ) @ #i) ∧ (Misuse( I ) @ #j)) ⇒ (#i = #j)"
  */

rule (modulo E) Rollback:
   [ St( I, q ), !Snap( I, q0 ) ]
  --[ Misuse( I ), Rollback( I, q, q0 ) ]->
   [ St( I, q0 ) ]

  // loop breakers: [0,1]
  /* has exactly the trivial AC variant */

rule (modulo E) RevealSeed:
   [ !Sk( I, sd ) ] --[ RevealSeed( I ) ]-> [ Out( sd ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_q0_a0:
   [
   !Root( I, hl(I, <ch(I, 'm', ch(I, 'm', ch(I, 'm', sm))), sk>, sib) ),
   In( <I, z, z, sm, sk, sib> )
   ]
  --[ Cks( z, s(s(s(z))) ), Accept( I, z, z ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_q0_a1:
   [
   !Root( I, hl(I, <ch(I, 'm', ch(I, 'm', sm)), ch(I, 'k', sk)>, sib) ),
   In( <I, z, s(z), sm, sk, sib> )
   ]
  --[ Cks( s(z), s(s(z)) ), Accept( I, z, s(z) ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_q0_a2:
   [
   !Root( I, hl(I, <ch(I, 'm', sm), ch(I, 'k', ch(I, 'k', sk))>, sib) ),
   In( <I, z, s(s(z)), sm, sk, sib> )
   ]
  --[ Cks( s(s(z)), s(z) ), Accept( I, z, s(s(z)) ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_q0_a3:
   [
   !Root( I, hl(I, <sm, ch(I, 'k', ch(I, 'k', ch(I, 'k', sk)))>, sib) ),
   In( <I, z, s(s(s(z))), sm, sk, sib> )
   ]
  --[ Cks( s(s(s(z))), z ), Accept( I, z, s(s(s(z))) ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_q1_a0:
   [
   !Root( I, hl(I, sib, <ch(I, 'm', ch(I, 'm', ch(I, 'm', sm))), sk>) ),
   In( <I, s(z), z, sm, sk, sib> )
   ]
  --[ Cks( z, s(s(s(z))) ), Accept( I, s(z), z ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_q1_a1:
   [
   !Root( I, hl(I, sib, <ch(I, 'm', ch(I, 'm', sm)), ch(I, 'k', sk)>) ),
   In( <I, s(z), s(z), sm, sk, sib> )
   ]
  --[ Cks( s(z), s(s(z)) ), Accept( I, s(z), s(z) ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_q1_a2:
   [
   !Root( I, hl(I, sib, <ch(I, 'm', sm), ch(I, 'k', ch(I, 'k', sk))>) ),
   In( <I, s(z), s(s(z)), sm, sk, sib> )
   ]
  --[ Cks( s(s(z)), s(z) ), Accept( I, s(z), s(s(z)) ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Verify_q1_a3:
   [
   !Root( I, hl(I, sib, <sm, ch(I, 'k', ch(I, 'k', ch(I, 'k', sk)))>) ),
   In( <I, s(z), s(s(s(z))), sm, sk, sib> )
   ]
  --[ Cks( s(s(s(z))), z ), Accept( I, s(z), s(s(s(z))) ) ]->
   [ ]

  /* has exactly the trivial AC variant */

lemma exec:
  exists-trace
  "∃ I q a #s #k.
    ((Sign( I, q, a ) @ #s) ∧ (Accept( I, q, a ) @ #k)) ∧
    (¬(∃ #r. RevealSeed( I ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ I q a #s #k.
  (Sign( I, q, a ) @ #s) ∧ (Accept( I, q, a ) @ #k)
 ∧
  ∀ #r. (RevealSeed( I ) @ #r) ⇒ ⊥"
*/
simplify
solve( Sign( I, q, a ) @ #s )
  case Sign_q0_a0
  solve( St( I, z ) ▶₀ #s )
    case KeyGen
    solve( Accept( ~I, z, z ) @ #k )
      case Verify_q0_a0
      solve( !Root( ~I,
                    hl(~I, <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', sm))), sk>, sib)
             ) ▶₀ #k )
        case KeyGen
        solve( !Sk( ~I, sd.1 ) ▶₁ #s )
          case KeyGen
          solve( !KU( ~I ) @ #vk.6 )
            case KeyGen
            solve( !KU( ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, z, 'k'))))
                   ) @ #vk.10 )
              case Sign_q0_a0_case_1
              solve( !KU( ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(z), 'm'))))
                     ) @ #vk.12 )
                case Sign_q0_a0
                solve( !KU( ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(z), 'k'))))
                       ) @ #vk.13 )
                  case Sign_q0_a0
                  solve( !KU( prf(~sd, z, 'm') ) @ #vk.13 )
                    case Sign_q0_a0
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma LS4_pure [use_induction]:
  all-traces
  "∀ I q a1 a2 #i #j.
    ((Sign( I, q, a1 ) @ #i) ∧ (Sign( I, q, a2 ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ I q a1 a2 #i #j.
  (Sign( I, q, a1 ) @ #i) ∧ (Sign( I, q, a2 ) @ #j) ∧ ¬(#i = #j)"
*/
by sorry

lemma LS4 [use_induction]:
  all-traces
  "∀ I q a1 a2 #i #j.
    ((Sign( I, q, a1 ) @ #i) ∧ (Sign( I, q, a2 ) @ #j)) ⇒
    ((#i = #j) ∨ (∃ x y #r. Rollback( I, x, y ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ I q a1 a2 #i #j.
  (Sign( I, q, a1 ) @ #i) ∧ (Sign( I, q, a2 ) @ #j)
 ∧
  (¬(#i = #j)) ∧ (∀ x y #r. (Rollback( I, x, y ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma LS1:

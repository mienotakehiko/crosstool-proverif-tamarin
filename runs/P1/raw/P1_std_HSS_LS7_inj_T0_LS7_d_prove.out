lemma exec:
  exists-trace
  "∃ I J m #k.
    ((HssAccept( I, J, m ) @ #k) ∧ (¬(∃ #r. RevealTop( I ) @ #r))) ∧
    (¬(∃ #r. RevealBot( I, J ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ I J m #k.
  (HssAccept( I, J, m ) @ #k)
 ∧
  (∀ #r. (RevealTop( I ) @ #r) ⇒ ⊥) ∧ (∀ #r. (RevealBot( I, J ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma TopAuth [reuse]:
  all-traces
  "∀ I J rB #k.
    (AcceptTop( I, J, rB ) @ #k) ⇒
    ((∃ #s. SignTop( I, J ) @ #s) ∨ (∃ #r. RevealTop( I ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ I J rB #k.
  (AcceptTop( I, J, rB ) @ #k)
 ∧
  (∀ #s. (SignTop( I, J ) @ #s) ⇒ ⊥) ∧ (∀ #r. (RevealTop( I ) @ #r) ⇒ ⊥)"
*/
by sorry

lemma LS7:
  all-traces
  "∀ I J m #k.
    (HssAccept( I, J, m ) @ #k) ⇒
    (((∃ #s #t. (SignTop( I, J ) @ #s) ∧ (SignBot( I, J, m ) @ #t)) ∨
      (∃ #r. RevealTop( I ) @ #r)) ∨
     (∃ #s #r. (SignTop( I, J ) @ #s) ∧ (RevealBot( I, J ) @ #r)))"
/*
guarded formula characterizing all counter-examples:
"∃ I J m #k.
  (HssAccept( I, J, m ) @ #k)
 ∧
  (∀ #s #t. (SignTop( I, J ) @ #s) ∧ (SignBot( I, J, m ) @ #t) ⇒ ⊥) ∧
  (∀ #r. (RevealTop( I ) @ #r) ⇒ ⊥) ∧
  (∀ #s #r. (SignTop( I, J ) @ #s) ∧ (RevealBot( I, J ) @ #r) ⇒ ⊥)"
*/

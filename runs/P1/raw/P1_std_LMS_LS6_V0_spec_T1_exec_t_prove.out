lemma exec:
  exists-trace
  "∃ I q a #s #k.
    ((Sign( I, q, a ) @ #s) ∧ (Accept( I, q, a ) @ #k)) ∧
    (¬(∃ #r. RevealSeed( I ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ I q a #s #k.
  (Sign( I, q, a ) @ #s) ∧ (Accept( I, q, a ) @ #k)
 ∧
  ∀ #r. (RevealSeed( I ) @ #r) ⇒ ⊥"
*/
simplify
solve( Sign( I, q, a ) @ #s )
  case Sign_q0_a0
  solve( St( I, z ) ▶₀ #s )
    case KeyGen
    solve( Accept( ~I, z, z ) @ #k )
      case Verify_q0_a0
      solve( !Root( ~I,
                    hn(~I, '1', 'dintr',
                       <
                        hn(~I, '2', 'dintr',
                           <
                            hn(~I, '4', 'dleaf',
                               pblc(~I, z, 'dpblc', <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', sm))), sk>)), 
                            p1>), 
                        p2>)
             ) ▶₀ #k )
        case KeyGen
        solve( !Sk( ~I, sd.1 ) ▶₁ #s )
          case KeyGen
          solve( !KU( ~I ) @ #vk.6 )
            case KeyGen
            solve( !KU( hn(~I, '5', 'dleaf',
                           pblc(~I, s(z), 'dpblc',
                                <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(z), 'm')))), 
                                 ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(z), 'k'))))>))
                   ) @ #vk.12 )
              case Sign_q0_a0
              solve( !KU( hn(~I, '3', 'dintr',
                             <
                              hn(~I, '6', 'dleaf',
                                 pblc(~I, s(s(z)), 'dpblc',
                                      <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(s(z)), 'm')))), 
                                       ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(s(z)), 'k'))))>)), 
                              hn(~I, '7', 'dleaf',
                                 pblc(~I, s(s(s(z))), 'dpblc',
                                      <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(s(s(z))), 'm')))), 
                                       ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(s(s(z))), 'k'))))>))
                             >)
                     ) @ #vk.13 )
                case Sign_q0_a0
                solve( !KU( ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, z, 'k'))))
                       ) @ #vk.13 )
                  case Sign_q0_a0
                  solve( !KU( prf(~sd, z, 'm') ) @ #vk.13 )
                    case Sign_q0_a0
                    SOLVED // trace found
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed


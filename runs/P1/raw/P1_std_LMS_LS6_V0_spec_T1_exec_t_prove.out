theory LMS_LS6_V0_spec

begin

// Function signature and definition of the equational theory E

functions: ch/3, fst/1, hn/4, pair/2, pblc/4, prf/3[private,constructor],
           s/1, snd/1, z/0
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

tactic: statefirst
presort: C
prio: {id}
  regex"St\(" | regex"Snap\(" | regex"BotSt\(" | regex"TopPending\("
prio: {id}
  regex"!Root\(" | regex"!TopOK\("
prio: {id}
  regex"Misuse\(" | regex"Clone\(" | regex"Rollback\("
deprio: {id}
  regex"KU\(*ch\(" | regex"KU\(*hl\("
deprio: {id}
  regex"KU\(*prf\("

/* looping facts with injective instances: St/2 */

rule (modulo E) KeyGen:
   [ Fr( ~I ), Fr( ~sd ) ]
  --[ KeyGen( ~I ) ]->
   [
   !Sk( ~I, ~sd ), St( ~I, z ),
   !Root( ~I,
          hn(~I, '1', 'dintr',
             <
              hn(~I, '2', 'dintr',
                 <
                  hn(~I, '4', 'dleaf',
                     pblc(~I, z, 'dpblc',
                          <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, z, 'm')))), 
                           ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, z, 'k'))))>)), 
                  hn(~I, '5', 'dleaf',
                     pblc(~I, s(z), 'dpblc',
                          <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(z), 'm')))), 
                           ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(z), 'k'))))>))
                 >), 
              hn(~I, '3', 'dintr',
                 <
                  hn(~I, '6', 'dleaf',
                     pblc(~I, s(s(z)), 'dpblc',
                          <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(s(z)), 'm')))), 
                           ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(s(z)), 'k'))))>)), 
                  hn(~I, '7', 'dleaf',
                     pblc(~I, s(s(s(z))), 'dpblc',
                          <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(s(s(z))), 'm')))), 
                           ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(s(s(z))), 'k'))))>))
                 >)
             >)
   ),
   Out( <~I, 
         hn(~I, '1', 'dintr',
            <
             hn(~I, '2', 'dintr',
                <
                 hn(~I, '4', 'dleaf',
                    pblc(~I, z, 'dpblc',
                         <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, z, 'm')))), 
                          ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, z, 'k'))))>)), 
                 hn(~I, '5', 'dleaf',
                    pblc(~I, s(z), 'dpblc',
                         <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(z), 'm')))), 
                          ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(z), 'k'))))>))
                >), 
             hn(~I, '3', 'dintr',
                <
                 hn(~I, '6', 'dleaf',
                    pblc(~I, s(s(z)), 'dpblc',
                         <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(s(z)), 'm')))), 
                          ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(s(z)), 'k'))))>)), 
                 hn(~I, '7', 'dleaf',
                    pblc(~I, s(s(s(z))), 'dpblc',
                         <ch(~I, 'm', ch(~I, 'm', ch(~I, 'm', prf(~sd, s(s(s(z))), 'm')))), 
                          ch(~I, 'k', ch(~I, 'k', ch(~I, 'k', prf(~sd, s(s(s(z))), 'k'))))>))
                >)
            >)
        >
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign_q0_a0:

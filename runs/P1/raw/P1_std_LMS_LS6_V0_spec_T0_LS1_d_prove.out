lemma exec:
  exists-trace
  "∃ I q a #s #k.
    ((Sign( I, q, a ) @ #s) ∧ (Accept( I, q, a ) @ #k)) ∧
    (¬(∃ #r. RevealSeed( I ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ I q a #s #k.
  (Sign( I, q, a ) @ #s) ∧ (Accept( I, q, a ) @ #k)
 ∧
  ∀ #r. (RevealSeed( I ) @ #r) ⇒ ⊥"
*/
by sorry

lemma LS1:
  all-traces
  "∀ I q a #k.
    (Accept( I, q, a ) @ #k) ⇒
    ((∃ #s. Sign( I, q, a ) @ #s) ∨ (∃ #r. RevealSeed( I ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ I q a #k.
  (Accept( I, q, a ) @ #k)
 ∧
  (∀ #s. (Sign( I, q, a ) @ #s) ⇒ ⊥) ∧ (∀ #r. (RevealSeed( I ) @ #r) ⇒ ⊥)"
*/
simplify
solve( Accept( I, q, a ) @ #k )
  case Verify_q0_a0
  solve( !Root( I,
                hn(I, '1', 'dintr',
                   <
                    hn(I, '2', 'dintr',
                       <
                        hn(I, '4', 'dleaf',
                           pblc(I, z, 'dpblc', <ch(I, 'm', ch(I, 'm', ch(I, 'm', sm))), sk>)), 
                        p1>), 
                    p2>)
         ) ▶₀ #k )
    case KeyGen
    solve( !KU( prf(~sd, z, 'm') ) @ #vk.6 )
      case Sign_q0_a0
      by contradiction /* from formulas */
    qed
  qed
next
  case Verify_q0_a1
  solve( !Root( I,
                hn(I, '1', 'dintr',
                   <
                    hn(I, '2', 'dintr',
                       <
                        hn(I, '4', 'dleaf',
                           pblc(I, z, 'dpblc', <ch(I, 'm', ch(I, 'm', sm)), ch(I, 'k', sk)>)), 
                        p1>), 
                    p2>)
         ) ▶₀ #k )
    case KeyGen
    solve( !KU( ch(~I, 'm', prf(~sd, z, 'm')) ) @ #vk.7 )
      case Sign_q0_a1
      by contradiction /* from formulas */
    next
      case c_ch
      solve( !KU( prf(~sd, z, 'm') ) @ #vk.14 )
        case Sign_q0_a0
        solve( !KU( ch(~I, 'k', ch(~I, 'k', prf(~sd, z, 'k'))) ) @ #vk.11 )
          case c_ch
          solve( !KU( ch(~I, 'k', prf(~sd, z, 'k')) ) @ #vk.18 )
            case c_ch
            by solve( !KU( prf(~sd, z, 'k') ) @ #vk.19 )
          qed
        qed
      qed
    qed
  qed
next
  case Verify_q0_a2
  solve( !Root( I,
                hn(I, '1', 'dintr',
                   <
                    hn(I, '2', 'dintr',
                       <
                        hn(I, '4', 'dleaf',
                           pblc(I, z, 'dpblc', <ch(I, 'm', sm), ch(I, 'k', ch(I, 'k', sk))>)), 
                        p1>), 
                    p2>)
         ) ▶₀ #k )
    case KeyGen
    solve( !KU( ch(~I, 'm', ch(~I, 'm', prf(~sd, z, 'm'))) ) @ #vk.7 )
      case Sign_q0_a2
      by contradiction /* from formulas */
    next
      case c_ch
      solve( !KU( ch(~I, 'k', prf(~sd, z, 'k')) ) @ #vk.9 )
        case Sign_q0_a2
        by contradiction /* from formulas */
      next
        case c_ch
        solve( !KU( prf(~sd, z, 'k') ) @ #vk.16 )
          case Sign_q0_a3
          solve( !KU( ch(~I, 'm', prf(~sd, z, 'm')) ) @ #vk.15 )
            case c_ch
            by solve( !KU( prf(~sd, z, 'm') ) @ #vk.20 )
          qed
        qed
      qed
    qed
  qed
next
  case Verify_q0_a3
  solve( !Root( I,
                hn(I, '1', 'dintr',
                   <
                    hn(I, '2', 'dintr',
                       <
                        hn(I, '4', 'dleaf',
                           pblc(I, z, 'dpblc', <sm, ch(I, 'k', ch(I, 'k', ch(I, 'k', sk)))>)), 
                        p1>), 
                    p2>)
         ) ▶₀ #k )
    case KeyGen
    solve( !KU( prf(~sd, z, 'k') ) @ #vk.9 )
      case Sign_q0_a3
      by contradiction /* from formulas */
    qed
  qed
next
  case Verify_q1_a0
  solve( !Root( I,
                hn(I, '1', 'dintr',
                   <
                    hn(I, '2', 'dintr',
                       <p1, 
                        hn(I, '5', 'dleaf',
                           pblc(I, s(z), 'dpblc', <ch(I, 'm', ch(I, 'm', ch(I, 'm', sm))), sk>))
                       >), 
                    p2>)
         ) ▶₀ #k )
    case KeyGen
    solve( !KU( prf(~sd, s(z), 'm') ) @ #vk.7 )
      case Sign_q1_a0_case_1
      by contradiction /* from formulas */
    next
      case Sign_q1_a0_case_2
      by contradiction /* from formulas */
    next
      case Sign_q1_a0_case_3
      by contradiction /* from formulas */
    next
      case Sign_q1_a0_case_4
      by contradiction /* from formulas */
    qed
  qed
next
  case Verify_q1_a1
  solve( !Root( I,
                hn(I, '1', 'dintr',
                   <
                    hn(I, '2', 'dintr',
                       <p1, 
                        hn(I, '5', 'dleaf',
                           pblc(I, s(z), 'dpblc', <ch(I, 'm', ch(I, 'm', sm)), ch(I, 'k', sk)>))
                       >), 
                    p2>)
         ) ▶₀ #k )
    case KeyGen
    solve( !KU( ch(~I, 'm', prf(~sd, s(z), 'm')) ) @ #vk.6 )
      case Sign_q1_a1_case_1
      by contradiction /* from formulas */
    next
      case Sign_q1_a1_case_2
      by contradiction /* from formulas */
    next
      case Sign_q1_a1_case_3
      by contradiction /* from formulas */
    next
      case Sign_q1_a1_case_4
      by contradiction /* from formulas */
    next
      case c_ch
      solve( !KU( prf(~sd, s(z), 'm') ) @ #vk.13 )
        case Sign_q1_a0_case_1
        solve( !KU( ch(~I, 'k', ch(~I, 'k', prf(~sd, s(z), 'k'))) ) @ #vk.9 )
          case c_ch
          solve( !KU( ch(~I, 'k', prf(~sd, s(z), 'k')) ) @ #vk.18 )
            case c_ch
            by solve( !KU( prf(~sd, s(z), 'k') ) @ #vk.19 )
          qed
        qed
      next
        case Sign_q1_a0_case_2
        solve( !KU( ch(~I, 'k', ch(~I, 'k', prf(~sd, s(z), 'k'))) ) @ #vk.10 )
          case c_ch
          solve( !KU( ch(~I, 'k', prf(~sd, s(z), 'k')) ) @ #vk.19 )
            case c_ch
            by solve( !KU( prf(~sd, s(z), 'k') ) @ #vk.20 )
          qed
        qed

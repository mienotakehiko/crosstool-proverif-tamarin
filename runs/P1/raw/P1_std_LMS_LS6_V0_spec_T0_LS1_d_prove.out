lemma LS6_bind:
  all-traces
  "∀ I q a #k.
    (Accept( I, q, a ) @ #k) ⇒
    ((∃ b #s. Sign( I, q, b ) @ #s) ∨ (∃ #r. RevealSeed( I ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ I q a #k.
  (Accept( I, q, a ) @ #k)
 ∧
  (∀ b #s. (Sign( I, q, b ) @ #s) ⇒ ⊥) ∧
  (∀ #r. (RevealSeed( I ) @ #r) ⇒ ⊥)"
*/
by sorry


lemma LS4_pure [use_induction]:
  all-traces
  "∀ I q a1 a2 #i #j.
    ((Sign( I, q, a1 ) @ #i) ∧ (Sign( I, q, a2 ) @ #j)) ⇒ (#i = #j)"
/*
guarded formula characterizing all counter-examples:
"∃ I q a1 a2 #i #j.
  (Sign( I, q, a1 ) @ #i) ∧ (Sign( I, q, a2 ) @ #j) ∧ ¬(#i = #j)"
*/
induction
  case non_empty_trace
  solve( Sign( I, q, a1 ) @ #i )
    case Sign_q0_a0
    solve( St( I, z ) ▶₀ #i )
      case Rollback
      solve( St( I, q ) ▶₀ #vr )
        case Sign_q0_a0_case_1
        solve( !Snap( ~I, z ) ▶₁ #vr )
          case KeyGen
          solve( Sign( ~I, z, a2 ) @ #j )
            case Sign_q0_a0
            solve( !Sk( ~I, sd ) ▶₁ #i )
              case KeyGen
              SOLVED // trace found
            qed
          qed
        qed
      qed
    qed
  qed
qed


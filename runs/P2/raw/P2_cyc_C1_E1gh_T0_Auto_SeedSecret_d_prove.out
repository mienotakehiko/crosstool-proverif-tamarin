// Function signature and definition of the equational theory E

functions: ch/2, fst/1, pair/2, s/1, snd/1, z/0
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2





/* looping facts with injective instances: G/4, V/8 */

restriction Neq:
  "∀ x y #i. (Neq( x, y ) @ #i) ⇒ (¬(x = y))"
  // safety formula

rule (modulo E) KeyGen:
   [ Fr( ~I ), Fr( ~x ), In( L ) ]
  --[ Start( ~I, ~x ), Gen( ~I, z, ~x ) ]->
   [ G( ~I, L, z, ~x ), !Sk( ~I, ~x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) GenStep:
   [ G( I, L, p, t ) ]
  --[ Neq( p, L ), Gen( I, s(p), ch(I, t) ) ]->
   [ G( I, L, s(p), ch(I, t) ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) GenDone:
   [ G( I, L, L, y ) ]
  --[ PkOut( I, y ) ]->
   [ !Pk( I, L, y ), Out( <I, L, y> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign:
   [ !Sk( I, x ), !Pk( I, L, y ), In( a ) ]
  --[ SignReq( I, a ) ]->
   [ S( I, z, x, a ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SigStep:
   [ S( I, p, t, a ) ] --[ Neq( p, a ) ]-> [ S( I, s(p), ch(I, t), a ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) SigEmit:
   [ S( I, a, t, a ) ] --[ Signed( I, a, t ) ]-> [ Out( <I, a, t> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) VerStart:
   [ !Pk( I, L, y ), In( <I, a, t> ), Fr( ~v ) ]
  --[ VerIn( ~v, I, a, t ) ]->
   [ V( ~v, I, L, a, t, a, t, y ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) VerStep:
   [ V( v, I, L, p, t, a, t0, y ) ]
  --[ Neq( p, L ), VStep( v, I, y ) ]->
   [ V( v, I, L, s(p), ch(I, t), a, t0, y ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) VerAccept:
   [ V( v, I, L, L, y, a, t0, y ) ]
  --[ Accept( v, I, a ), AcceptV( v, I, a, t0 ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) RevealSk:
   [ !Sk( I, x ) ] --[ Reveal( I ) ]-> [ Out( x ) ]


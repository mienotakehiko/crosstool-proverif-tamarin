theory LMOTS_E1u begin

// Function signature and definition of the equational theory E

functions: ch/3, fst/1, pair/2, s/1, snd/1, z/0
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2





/* looping facts with injective instances: GenM/4, VerM/9 */

restriction Cks:
  "∀ a c #i.
    (Cks( a, c ) @ #i) ⇒
    (((((a = z) ∧ (c = s(s(s(z))))) ∨ ((a = s(z)) ∧ (c = s(s(z))))) ∨
      ((a = s(s(z))) ∧ (c = s(z)))) ∨
     ((a = s(s(s(z)))) ∧ (c = z)))"
  // safety formula

restriction One:
  "∀ I #i #j. ((OneSig( I ) @ #i) ∧ (OneSig( I ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction Neq:
  "∀ x y #i. (Neq( x, y ) @ #i) ⇒ (¬(x = y))"
  // safety formula

rule (modulo E) KeyGen:
   [ Fr( ~I ), Fr( ~xm ), Fr( ~xk ) ]
  --[ KeyGen( ~I ), Val( ~I, 'm', z, ~xm ), Val( ~I, 'k', z, ~xk ) ]->
   [ GenM( ~I, z, ~xm, ~xk ), !Sk( ~I, ~xm, ~xk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) GenStepM:
   [ GenM( I, p, t, xk ) ]
  --[ Neq( p, s(s(s(z))) ), Val( I, 'm', s(p), ch(I, 'm', t) ) ]->
   [ GenM( I, s(p), ch(I, 'm', t), xk ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) GenSwitch:
   [ GenM( I, s(s(s(z))), ym, xk ) ] --> [ GenK( I, z, xk, ym ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) GenStepK:
   [ GenK( I, p, t, ym ) ]
  --[ Neq( p, s(s(s(z))) ), Val( I, 'k', s(p), ch(I, 'k', t) ) ]->
   [ GenK( I, s(p), ch(I, 'k', t), ym ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) GenDone:
   [ GenK( I, s(s(s(z))), yk, ym ) ]
  --[ PkDone( I, ym, yk ) ]->
   [ !Pk( I, ym, yk ), Out( <I, ym, yk> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SignStart:
   [ !Sk( I, xm, xk ), !Pk( I, ym, yk ), In( <'sign', a, c> ) ]
  --[ OneSig( I ), Cks( a, c ), SignReq( I, a ) ]->
   [ SigM( I, z, xm, a, c, xk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SigStepM:
   [ SigM( I, p, t, a, c, xk ) ]
  --[ Neq( p, a ) ]->
   [ SigM( I, s(p), ch(I, 'm', t), a, c, xk ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) SigSwitch:
   [ SigM( I, a, sm, a, c, xk ) ] --> [ SigK( I, z, xk, a, c, sm ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SigStepK:
   [ SigK( I, p, t, a, c, sm ) ]
  --[ Neq( p, c ) ]->
   [ SigK( I, s(p), ch(I, 'k', t), a, c, sm ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) SigEmit:
   [ SigK( I, c, sk, a, c, sm ) ]
  --[ Signed( I, a ), SigVal( I, 'm', a, sm ), SigVal( I, 'k', c, sk ) ]->
   [ Out( <I, a, sm, c, sk> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RevealSk:
   [ !Sk( I, xm, xk ) ] --[ RevealSk( I ) ]-> [ Out( <xm, xk> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) VerStart:
   [ !Pk( I, ym, yk ), In( <I, a, sm, c, sk> ), Fr( ~v ) ]
  --[ Cks( a, c ), VerStart( ~v, I, a ) ]->
   [ VerM( ~v, I, a, sm, a, c, sk, ym, yk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) VerStepM:
   [ VerM( v, I, p, t, a, c, sk, ym, yk ) ]
  --[ Neq( p, s(s(s(z))) ) ]->
   [ VerM( v, I, s(p), ch(I, 'm', t), a, c, sk, ym, yk ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) VerSwitch:
   [ VerM( v, I, s(s(s(z))), ym, a, c, sk, ym, yk ) ]
  -->
   [ VerK( v, I, c, sk, a, yk ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) VerStepK:
   [ VerK( v, I, p, t, a, yk ) ]
  --[ Neq( p, s(s(s(z))) ) ]->
   [ VerK( v, I, s(p), ch(I, 'k', t), a, yk ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) VerAccept:
   [ VerK( v, I, s(s(s(z))), yk, a, yk ) ] --[ Accept( v, I, a ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma exec_accept:
  exists-trace
  "∃ v I a #s #k.
    ((Signed( I, a ) @ #s) ∧ (Accept( v, I, a ) @ #k)) ∧
    (¬(∃ #r. RevealSk( I ) @ #r))"
/*
guarded formula characterizing all satisfying traces:
"∃ v I a #s #k.
  (Signed( I, a ) @ #s) ∧ (Accept( v, I, a ) @ #k)
 ∧
  ∀ #r. (RevealSk( I ) @ #r) ⇒ ⊥"
*/
by sorry

lemma LS5_oneway:
  all-traces
  "∀ I cid p t #v #k.
    (((Val( I, cid, p, t ) @ #v) ∧ (!KU( t ) @ #k)) ∧ (¬(p = s(s(s(z)))))) ⇒
    ((∃ q u #s.
       (SigVal( I, cid, q, u ) @ #s) ∧
       ((q = p) ∨
        (∃ d.
          (p = s(d)) ∧
          ((q = d) ∨
           (∃ e. (d = s(e)) ∧ ((q = e) ∨ (∃ f. (e = s(f)) ∧ (q = f)))))))) ∨
     (∃ #r. RevealSk( I ) @ #r))"
/*
guarded formula characterizing all counter-examples:
"∃ I cid p t #v #k.
  (Val( I, cid, p, t ) @ #v) ∧ (!KU( t ) @ #k)
 ∧
  (¬(p = s(s(s(z))))) ∧
  (∀ q u #s.
    (SigVal( I, cid, q, u ) @ #s)
   ⇒
    (¬(q = p)) ∧
    (∀ d.
      (p = s(d))
     ⇒
      (¬(q = d)) ∧
      (∀ e. (d = s(e)) ⇒ (¬(q = e)) ∧ (∀ f. (e = s(f)) ∧ (q = f) ⇒ ⊥)))) ∧
  (∀ #r. (RevealSk( I ) @ #r) ⇒ ⊥)"
*/
by sorry


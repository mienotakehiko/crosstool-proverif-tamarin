theory C1_E2r begin

// Function signature and definition of the equational theory E

functions: ch/2, fst/1, pair/2, s/1, snd/1, z/0
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2





/* looping facts with injective instances: G/3, V/7 */

restriction Neq:
  "∀ x y #i. (Neq( x, y ) @ #i) ⇒ (¬(x = y))"
  // safety formula

rule (modulo E) KeyGen:
   [ Fr( ~I ), Fr( ~x ) ]
  --[ Start( ~I, ~x ), Gen( ~I, z, ~x ) ]->
   [ G( ~I, z, ~x ), !Sk( ~I, ~x ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) GenStep:
   [ G( I, p, t ) ]
  --[ Neq( p, s(s(s(z))) ), Gen( I, s(p), ch(I, t) ) ]->
   [ G( I, s(p), ch(I, t) ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) GenDone:
   [ G( I, s(s(s(z))), y ) ]
  --[ PkOut( I, y ) ]->
   [ !Pk( I, y ), Out( <I, y> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Sign:
   [ !Sk( I, x ), !Pk( I, y ), In( a ) ]
  --[ SignReq( I, a ) ]->
   [ S( I, z, x, a ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) SigStep:
   [ S( I, p, t, a ) ] --[ Neq( p, a ) ]-> [ S( I, s(p), ch(I, t), a ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) SigEmit:
   [ S( I, a, t, a ) ] --[ Signed( I, a, t ) ]-> [ Out( <I, a, t> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Rem:
   [ In( <I, a, t> ) ] --> [ Rem( I, a, t, a, s(s(s(z))) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) RemStep:
   [ Rem( I, a, t, s(q), s(u) ) ] --> [ Rem( I, a, t, q, u ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) VerStart:
   [ !Pk( I, y ), Rem( I, a, t, z, u ), Fr( ~v ) ]
  --[ VerIn( ~v, I, a, t ) ]->
   [ V( ~v, I, t, u, a, t, y ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) VerStep:
   [ V( v, I, t, s(r), a, t0, y ) ]
  --[ VStep( v, I, t, r, y ) ]->
   [ V( v, I, ch(I, t), r, a, t0, y ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) VerAccept:
   [ V( v, I, y, z, a, t0, y ) ]
  --[ Accept( v, I, a ), AcceptV( v, I, a, t0 ), VStep( v, I, y, z, y ) ]->
   [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) RevealSk:
   [ !Sk( I, x ) ] --[ Reveal( I ) ]-> [ Out( x ) ]

  /* has exactly the trivial AC variant */

